<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/site-conf.xsd">

    <description>Wantok Keycloak OIDC controller</description>

    <request-map uri="oidcLogin">
        <security https="false" auth="false"/>
        <event type="java" path="com.cloudcode.wantok.keycloak.WanKeycloakEvents" invoke="oidcLogin"/>
        <response name="success" type="none"/>
        <response name="error" type="view" value="error"/>
    </request-map>

    <request-map uri="oidcCallback">
        <security https="false" auth="false"/>
        <event type="java" path="com.cloudcode.wantok.keycloak.WanKeycloakEvents" invoke="oidcCallback"/>
        <response name="success" type="none"/>
        <response name="error" type="view" value="error"/>
    </request-map>

    <request-map uri="oidcLogout">
        <security https="false" auth="false"/>
        <event type="java" path="com.cloudcode.wantok.keycloak.WanKeycloakEvents" invoke="oidcLogout"/>
        <response name="success" type="none"/>
    </request-map>

    <request-map uri="loggedOut">
        <security https="false" auth="false"/>
        <response name="success" type="view" value="loggedOut"/>
    </request-map>

    <view-map name="error" type="screen" page="component://wankeycloak/widget/WanKeycloakScreens.xml#Error"/>
    <view-map name="loggedOut" type="screen" page="component://wankeycloak/widget/WanKeycloakScreens.xml#LoggedOut"/>
</site-conf>
