    /** Actor- and store-scoped v396 GET; exposes tender allocations but never bank secrets. */
    public static Map<String, Object> v396GetMixedSale(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "v396GetMixedSale");
            GenericValue sale = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                    .where("idempotencyKey", required(ctx, "idempotencyKey")).queryOne();
            if (sale == null) return denied();
            scope(dctx, who, sale.getString("productStoreId"), sale.getString("facilityId"), "VIEW");
            if (!who.getString("userLoginId").equals(sale.getString("actorUserLoginId"))
                    && !allowed(dctx, who, "REPORT")) return denied();
            List<GenericValue> portions = EntityQuery.use(dctx.getDelegator())
                    .from("WanPosV396SaleTender")
                    .where("idempotencyKey", sale.getString("idempotencyKey")).queryList();
            if (portions.isEmpty()) return denied();
            List<Map<String, Object>> details = new ArrayList<>();
            for (GenericValue portion : portions) {
                details.add(data(portion, "tenderType", "amount", "paymentId", "paymentPreferenceId"));
            }
            GenericValue cashOut = EntityQuery.use(dctx.getDelegator())
                    .from("WanPosV396Cashout")
                    .where("idempotencyKey", sale.getString("idempotencyKey")).queryOne();
            Map<String, Object> payload = data(sale, "idempotencyKey", "orderId", "invoiceId",
                    "receiptNumber", "totalAmount", "tenderType", "statusId", "shiftId", "terminalId");
            payload.put("tenders", details);
            payload.put("cashOutAmount", cashOut == null ? BigDecimal.ZERO : cashOut.getBigDecimal("cashOutAmount"));
            payload.put("bankChargeAmount", cashOut == null ? sale.getBigDecimal("eftposReceiptAmount")
                    : cashOut.getBigDecimal("bankAmount"));
            return ok("sale", payload);
        } catch (Exception e) {
            return error(e);
        }
    }


