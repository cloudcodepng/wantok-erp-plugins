/**
 * PART G additive POS services; NEVER exposes an unauthenticated OFBiz actor lookup.
 * Integration authentication must be performed by trusted Quarkus, not browser JS.
 * The inbound OFBiz service userLogin is the transport bridge and MUST have
 * WANERP_POS_BRIDGE permission. Human identity is verified by a tenant-scoped
 * HMAC assertion signed by Quarkus and is used by native financial services.
 * The bridge is never substituted as the native business operator.
 */
public final class WanErpPosServices {
    private static final String BRIDGE_PERMISSION = "WANERP_POS_BRIDGE";
    private static final Pattern CODE = Pattern.compile("[A-Za-z0-9_.:-]{1,80}");
    private static final Pattern BARCODE = Pattern.compile("[0-9A-Za-z()\u001d-]{4,80}");
    private static final long MAX_CLOCK_SKEW_MS = 45_000L;
    private static final Set<String> ACTIONS = Set.of("LOGIN", "VIEW", "SALE", "RETURN", "REFUND", "SHIFT_CLOSE", "TERMINAL_VIEW",
            "TERMINAL_ADMIN", "REPORT", "EFTPOS_RECONCILE", "IMPORT_PRODUCTS");
    private WanErpPosServices() { }

    /**
     * Serializes financial return execution and failed-attempt resolution on the
     * original sale row. OFBiz 24.09 EntityQuery has no forUpdate() method.
     * SQLProcessor uses the tenant's JTA-enlisted helper, matching the existing
     * EFTPOS reconciliation row-lock pattern in this class. Caller must execute
     * inside a transactional OFBiz service; do not use outside that boundary.
     */
    static boolean lockOriginalSaleForReturn(Delegator delegator, String saleKey) throws Exception {
        try (SQLProcessor sql = new SQLProcessor(delegator,
                delegator.getGroupHelperInfo(delegator.getEntityGroupName("WanPosSaleRequest")))) {
            sql.prepareStatement("SELECT IDEMPOTENCY_KEY FROM WAN_POS_SALE_REQUEST "
                    + "WHERE IDEMPOTENCY_KEY = ? FOR UPDATE");
            sql.setValue(saleKey);
            try (ResultSet locked = sql.executeQuery()) {
                return locked.next();
            }
        }
    }
    private static String string(Map<String, ? extends Object> context, String field) {
        Object v = context.get(field);
        return v == null ? null : v.toString();
    }
    private static String required(Map<String, ? extends Object> ctx, String field) {
        String v = string(ctx, field);
        if (v == null || !CODE.matcher(v).matches()) {
            throw new IllegalArgumentException("Invalid " + field);
        }
        return v;
    }
    private static Map<String, Object> ok(String key, Object value) {
        Map<String, Object> out = ServiceUtil.returnSuccess();
        out.put(key, value);
        return out;
    }
    private static Map<String, Object> denied() {
        return ServiceUtil.returnError("POS permission or location denied");
    }
    private static Map<String, Object> failed() {
        return ServiceUtil.returnError("POS service unavailable; request not committed");
    }
    private static String tenant(Delegator d) {
        String name = d.getDelegatorName();
        int i = name.indexOf('#');
        if (i < 0 || i == name.length() - 1) {
            throw new IllegalArgumentException("Tenant-specific delegator required");
        }
        String tenantId = name.substring(i + 1);
        if (!CODE.matcher(tenantId).matches()) {
            throw new IllegalArgumentException("Invalid tenant");
        }
        return tenantId;
    }
    private static String perm(Delegator d, String action) {
        return tenant(d).toUpperCase(Locale.ROOT) + "_POS_" + action;
    }
    private static boolean live(GenericValue login) {
        if (login == null || login.getString("partyId") == null) {
            return false;
        }
        String enabled = login.getString("enabled");
        if ("N".equalsIgnoreCase(enabled)) {
            return false;
        }
        // The native userLogin service evaluates temporary lockout expiration.
        // A historical disabledDateTime alone must not invalidate a verified login.
        String disabledBy = login.getString("disabledBy");
        return disabledBy == null || disabledBy.isBlank();
    }
    private static GenericValue user(Delegator d, String id) throws Exception {
        GenericValue login = EntityQuery.use(d).from("UserLogin").where("userLoginId", id).queryOne();
        if (!live(login)) {
            throw new IllegalArgumentException("Inactive user");
        }
        GenericValue party = EntityQuery.use(d).from("Party").where("partyId", login.getString("partyId")).queryOne();
        if (party == null || "PARTY_DISABLED".equals(party.getString("statusId"))) {
            throw new IllegalArgumentException("Inactive party");
        }
        return login;
    }
    private static List<String> groups(Delegator d, String userLoginId) throws Exception {
        Timestamp now = new Timestamp(System.currentTimeMillis());
        Set<String> out = new LinkedHashSet<>();
        for (GenericValue row : EntityQuery.use(d).from("UserLoginSecurityGroup").where("userLoginId", userLoginId).queryList()) {
            Timestamp from = row.getTimestamp("fromDate");
            Timestamp thru = row.getTimestamp("thruDate");
            if ((from == null || !from.after(now)) && (thru == null || thru.after(now))) {
                out.add(row.getString("groupId"));
            }
        }
        return new ArrayList<>(out);
    }
    private static boolean allowed(DispatchContext dctx, GenericValue actor, String action) {
        return dctx.getSecurity().hasPermission(perm(dctx.getDelegator(), action), actor);
    }
    private static void bridge(DispatchContext dctx, Map<String, Object> ctx) {
        GenericValue gateway = (GenericValue) ctx.get("userLogin");
        if (gateway == null || !dctx.getSecurity().hasPermission(BRIDGE_PERMISSION, gateway)) {
            throw new IllegalArgumentException("Untrusted bridge");
        }
    }
    /**
     * Actor proof: base64url(HMAC-SHA256(secret, tenant\nactor\noperation\nrequestId\nissuedAtMillis)).
     * Quarkus uses a secret unique to each tenant from its secure server configuration.
     * OFBiz reads WANERP_POS_BRIDGE_SECRET_<TENANT> from its server environment.
     * Assertion cannot be minted by APEX, browsers or a generic REST caller.
     */
    private static GenericValue actor(DispatchContext dctx, Map<String, Object> ctx, String operation) throws Exception {
        bridge(dctx, ctx);
        Delegator d = dctx.getDelegator();
        String who = required(ctx, "actorUserLoginId");
        String requestId = required(ctx, "requestId");
        Object time = ctx.get("issuedAtMillis");
        if (!(time instanceof Long)) {
            throw new IllegalArgumentException("Invalid assertion time");
        }
        long issued = (Long) time;
        if (Math.abs(System.currentTimeMillis() - issued) > MAX_CLOCK_SKEW_MS) {
            throw new IllegalArgumentException("Expired assertion");
        }
        String env = "WANERP_POS_BRIDGE_SECRET_" + tenant(d).toUpperCase(Locale.ROOT);
        String secret = System.getenv(env);
        if (secret == null || secret.length() < 32) {
            throw new IllegalArgumentException("POS bridge not configured");
        }
        String message = tenant(d) + "\n" + who + "\n" + operation + "\n" + requestId + "\n" + issued;
        Mac mac = Mac.getInstance("HmacSHA256");
        mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
        byte[] signature = mac.doFinal(message.getBytes(StandardCharsets.UTF_8));
        byte[] provided;
        try {
            provided = Base64.getUrlDecoder().decode(string(ctx, "actorProof"));
        } catch (RuntimeException e) {
            throw new IllegalArgumentException("Invalid assertion");
        }
        if (!MessageDigest.isEqual(signature, provided)) {
            throw new IllegalArgumentException("Invalid assertion");
        }
        return user(d, who);
    }
    private static boolean belongsToStore(Delegator d, String storeId, String facilityId) throws Exception {
        GenericValue store = EntityQuery.use(d).from("ProductStore").where("productStoreId", storeId).queryOne();
        if (store == null) {
            return false;
        }
        if (facilityId == null) {
            return true;
        }
        if (EntityQuery.use(d).from("Facility").where("facilityId", facilityId).queryOne() == null) {
            return false;
        }
        if (facilityId.equals(store.getString("inventoryFacilityId"))) {
            return true;
        }
        Timestamp now = new Timestamp(System.currentTimeMillis());
        for (GenericValue sf : EntityQuery.use(d).from("ProductStoreFacility").where("productStoreId", storeId, "facilityId",
                facilityId).queryList()) {
            if (active(sf, now)) {
                return true;
            }
        }
        return false;
    }
    private static boolean active(GenericValue row, Timestamp now) {
        Timestamp start = row.getTimestamp("fromDate");
        Timestamp end = row.getTimestamp("thruDate");
        return (start == null || !start.after(now)) && (end == null || end.after(now));
    }
    private static boolean grant(Delegator d, String username, String store, String facility, String need) throws Exception {
        if (!belongsToStore(d, store, facility)) {
            return false;
        }
        Timestamp now = new Timestamp(System.currentTimeMillis());
        for (GenericValue row : EntityQuery.use(d).from("WanPosUserStoreGrant")
                .where("userLoginId", username, "productStoreId", store).queryList()) {
            if (!active(row, now)) {
                continue;
            }
            String code = row.getString("accessCode");
            boolean match = need.equals(code) || ("VIEW".equals(need) && ("SALE".equals(code) || "MANAGE".equals(code)));
            if (!match) {
                continue;
            }
            String f = row.getString("facilityId");
            // Null grant facility means only native store-linked facilities; never any arbitrary facility.
            if (f == null || f.equals(facility)) {
                return true;
            }
        }
        return false;
    }
    private static GenericValue scope(DispatchContext dctx, GenericValue who, String store, String fac, String action) throws Exception {
        if (!allowed(dctx, who, action)
                || !grant(dctx.getDelegator(), who.getString("userLoginId"), store, fac, ("TERMINAL_ADMIN".equals(action)
                || "REPORT".equals(action)) ? "MANAGE" : ("EFTPOS_RECONCILE".equals(action) ? "RECONCILE"
                : ("SALE".equals(action) ? "SALE" : "VIEW")))) {
            throw new IllegalArgumentException("Denied");
        }
        return who;
    }
    private static GenericValue terminal(Delegator d, String terminalId) throws Exception {
        GenericValue row = EntityQuery.use(d).from("WanPosTerminal").where("terminalId", terminalId).queryOne();
        if (row == null || !"Y".equals(row.getString("enabled"))) {
            throw new IllegalArgumentException("Terminal unavailable");
        }
        if (!belongsToStore(d, row.getString("productStoreId"), row.getString("facilityId"))) {
            throw new IllegalArgumentException("Terminal binding invalid");
        }
        return row;
    }
    private static GenericValue accessibleTerminal(DispatchContext dctx, GenericValue actor, String id, String action) throws Exception {
        GenericValue t = terminal(dctx.getDelegator(), id);
        scope(dctx, actor, t.getString("productStoreId"), t.getString("facilityId"), action);
        return t;
    }
    private static GenericValue shift(Delegator d, String shiftId, GenericValue terminal, String actorLoginId) throws Exception {
        GenericValue s = EntityQuery.use(d).from("WanPosShift").where("shiftId", shiftId).queryOne();
        if (s == null || !"OPEN".equals(s.getString("statusId"))
                || !terminal.getString("terminalId").equals(s.getString("terminalId"))
                || !terminal.getString("productStoreId").equals(s.getString("productStoreId"))
                || !terminal.getString("facilityId").equals(s.getString("facilityId"))
                || !actorLoginId.equals(s.getString("cashierUserLoginId"))) {
            throw new IllegalArgumentException("Shift mismatch");
        }
        return s;
    }
    private static Map<String, Object> data(GenericValue row, String... keys) {
        Map<String, Object> map = new LinkedHashMap<>();
        for (String key : keys) {
            map.put(key, row.get(key));
        }
        return map;
    }
    static void audit(DispatchContext dctx, GenericValue who, String action, String store, String facility,
            String terminal, String shift, String entity, String req, String outcome) throws Exception {
        Delegator d = dctx.getDelegator();
        GenericValue a = d.makeValue("WanPosAudit");
        a.set("auditId", d.getNextSeqId("WanPosAudit"));
        a.set("eventAt", new Timestamp(System.currentTimeMillis()));
        a.set("actorUserLoginId", who.getString("userLoginId"));
        a.set("actorPartyId", who.getString("partyId"));
        a.set("action", action);
        a.set("productStoreId", store);
        a.set("facilityId", facility);
        a.set("terminalId", terminal);
        a.set("shiftId", shift);
        a.set("entityId", entity);
        a.set("requestId", req);
        a.set("outcome", outcome);
        d.create(a);
    }
    private static Map<String, Object> error(Exception ex) {
        // Deliberately do not echo OFBiz login internals, attacker-selected values, or credentials.
        return ex instanceof IllegalArgumentException ? denied() : failed();
    }
    /** Service requires authenticated, explicitly permitted server-side Quarkus integration account. */
    public static Map<String, Object> authenticate(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            bridge(dctx, ctx);
            if (!tenant(dctx.getDelegator()).equals(string(ctx, "tenantId"))) {
                return denied();
            }
            String name = required(ctx, "username");
            String password = string(ctx, "password");
            if (password == null || password.isEmpty()) {
                return ServiceUtil.returnError("Invalid credentials");
            }
            Map<String, Object> input = new HashMap<>();
            input.put("login.username", name);
            input.put("login.password", password);
            Map<String, Object> result = dctx.getDispatcher().runSync("userLogin", input);
            if (!ServiceUtil.isSuccess(result)) {
                return ServiceUtil.returnError("Invalid credentials");
            }
            GenericValue authenticated = (GenericValue) result.get("userLogin");
            if (authenticated == null || !name.equals(authenticated.getString("userLoginId"))) {
                return ServiceUtil.returnError("Invalid credentials");
            }
            GenericValue who = user(dctx.getDelegator(), name);
            List<String> granted = new ArrayList<>();
            for (String action : ACTIONS) {
                if (allowed(dctx, who, action)) {
                    granted.add(perm(dctx.getDelegator(), action));
                }
            }
            if (!granted.contains(perm(dctx.getDelegator(), "LOGIN")) && !granted.contains(perm(dctx.getDelegator(), "TERMINAL_ADMIN"))) {
                return denied();
            }
            Map<String, Object> out = ServiceUtil.returnSuccess();
            out.put("userLoginId", who.getString("userLoginId"));
            out.put("partyId", who.getString("partyId"));
            out.put("groups", groups(dctx.getDelegator(), name));
            out.put("permissions", granted);
            out.put("stores", stores(dctx.getDelegator(), name));
            out.put("requirePasswordChange", "Y".equalsIgnoreCase(who.getString("requirePasswordChange")));
            return out;
        } catch (Exception e) {
            return ServiceUtil.returnError("Invalid credentials or POS access denied");
        }
    }
    private static List<Map<String, Object>> stores(Delegator d, String name) throws Exception {
        List<Map<String, Object>> stores = new ArrayList<>();
        Timestamp now = new Timestamp(System.currentTimeMillis());
        for (GenericValue g : EntityQuery.use(d).from("WanPosUserStoreGrant").where("userLoginId", name).queryList()) {
            if (active(g, now) && belongsToStore(d, g.getString("productStoreId"), g.getString("facilityId"))) {
                Map<String, Object> labeled = data(g, "grantId", "productStoreId", "facilityId", "accessCode", "fromDate", "thruDate");
                GenericValue ps = EntityQuery.use(d).from("ProductStore")
                        .where("productStoreId", g.getString("productStoreId")).queryOne();
                if (ps != null) {
                    labeled.put("productStoreName", ps.getString("storeName"));
                }
                if (g.getString("facilityId") != null) {
                    GenericValue fac = EntityQuery.use(d).from("Facility")
                            .where("facilityId", g.getString("facilityId")).queryOne();
                    if (fac != null) {
                        labeled.put("facilityName", fac.getString("facilityName"));
                    }
                }
                stores.add(labeled);
            }
        }
        return stores;
    }
    public static Map<String, Object> allowedStores(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "allowedStores");
            return ok("stores", stores(dctx.getDelegator(), who.getString("userLoginId")));
        } catch (Exception e) {
            return error(e);
        }
    }
    public static Map<String, Object> authorize(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "authorize");
            String action = required(ctx, "actionCode");
            if (!ACTIONS.contains(action)) {
                return denied();
            }
            String store = required(ctx, "productStoreId");
            String facility = string(ctx, "facilityId");
            scope(dctx, who, store, facility, action);
            if (ctx.get("terminalId") != null) {
                GenericValue t = terminal(dctx.getDelegator(), required(ctx, "terminalId"));
                if (!store.equals(t.getString("productStoreId"))
                        || (facility != null && !facility.equals(t.getString("facilityId")))) {
                    return denied();
                }
                if (ctx.get("shiftId") != null) {
                    shift(dctx.getDelegator(), required(ctx, "shiftId"), t, who.getString("userLoginId"));
                }
            } else if (ctx.get("shiftId") != null) {
                return denied();
            }
            Map<String, Object> out = new LinkedHashMap<>();
            out.put("productStoreId", store);
            out.put("facilityId", facility);
            out.put("actionCode", action);
            out.put("actorUserLoginId", who.getString("userLoginId"));
            return ok("scope", out);
        } catch (Exception e) {
            return error(e);
        }
    }
    private static boolean admin(DispatchContext dctx, GenericValue who) {
        return allowed(dctx, who, "TERMINAL_ADMIN");
    }
    public static Map<String, Object> grantStore(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "grantStore");
            if (!admin(dctx, who)) {
                return denied();
            }
            String name = required(ctx, "targetUserLoginId");
            GenericValue target = user(dctx.getDelegator(), name);
            String store = required(ctx, "productStoreId");
            String facility = string(ctx, "facilityId");
            String access = required(ctx, "accessCode");
            if ("RECONCILE".equals(access) && !allowed(dctx, target, "EFTPOS_RECONCILE")) {
                return denied();
            }
            if (!Set.of("VIEW", "SALE", "MANAGE", "INVENTORY", "RECONCILE").contains(access)
                    || !belongsToStore(dctx.getDelegator(), store, facility)
                    || string(ctx, "reason") == null || string(ctx, "reason").isBlank()) {
                return denied();
            }
            Timestamp now = new Timestamp(System.currentTimeMillis());
            Timestamp start = (Timestamp) ctx.getOrDefault("fromDate", now);
            Timestamp thru = (Timestamp) ctx.get("thruDate");
            if (start == null) {
                start = now;
            }
            if (thru != null && !thru.after(start)) {
                return denied();
            }
            // Grant administration is itself limited to an explicit MANAGE store assignment.
            if (!grant(dctx.getDelegator(), who.getString("userLoginId"), store, facility, "MANAGE")) {
                return denied();
            }
            GenericValue g = dctx.getDelegator().makeValue("WanPosUserStoreGrant");
            g.set("grantId", dctx.getDelegator().getNextSeqId("WanPosUserStoreGrant"));
            g.set("userLoginId", name);
            g.set("productStoreId", store);
            g.set("facilityId", facility);
            g.set("accessCode", access);
            g.set("fromDate", start);
            g.set("thruDate", thru);
            g.set("grantedByUserLoginId", who.getString("userLoginId"));
            g.set("reason", string(ctx, "reason"));
            dctx.getDelegator().create(g);
            audit(dctx, who, "GRANT_STORE", store, facility, null, null, g.getString("grantId"), string(ctx, "requestId"), "SUCCESS");
            return ok("grantId", g.getString("grantId"));
        } catch (Exception e) {
            return error(e);
        }
    }
    public static Map<String, Object> revokeStore(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "revokeStore");
            if (!admin(dctx, who) || string(ctx, "reason") == null || string(ctx, "reason").isBlank()) {
                return denied();
            }
            GenericValue g = EntityQuery.use(dctx.getDelegator()).from("WanPosUserStoreGrant").where("grantId", required(ctx, "grantId")).queryOne();
            if (g == null || !grant(dctx.getDelegator(), who.getString("userLoginId"), g.getString("productStoreId"),
                    g.getString("facilityId"), "MANAGE")) {
                return denied();
            }
            Timestamp now = new Timestamp(System.currentTimeMillis());
            if (g.getTimestamp("thruDate") == null || g.getTimestamp("thruDate").after(now)) {
                g.set("thruDate", now);
                g.store();
            }
            audit(dctx, who, "REVOKE_GRANT", g.getString("productStoreId"), g.getString("facilityId"), null, null, g.getString("grantId"),
                    string(ctx, "requestId"), "SUCCESS");
            return ok("revoked", Boolean.TRUE);
        } catch (Exception e) {
            return error(e);
        }
    }
    public static Map<String, Object> saveTerminal(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "saveTerminal");
            String id = required(ctx, "terminalId");
            String store = required(ctx, "productStoreId");
            String fac = required(ctx, "facilityId");
            if (!admin(dctx, who) || !grant(dctx.getDelegator(), who.getString("userLoginId"), store, fac, "MANAGE")) {
                return denied();
            }
            if (!belongsToStore(dctx.getDelegator(), store, fac)) {
                return denied();
            }
            GenericValue t = EntityQuery.use(dctx.getDelegator()).from("WanPosTerminal").where("terminalId", id).queryOne();
            if (t != null) {
                // A remapping admin must also control the OLD store/facility, not just the destination.
                scope(dctx, who, t.getString("productStoreId"), t.getString("facilityId"), "TERMINAL_ADMIN");
                boolean remap = !store.equals(t.getString("productStoreId")) || !fac.equals(t.getString("facilityId"));
                if (remap || Boolean.FALSE.equals(ctx.get("enabled"))) {
                    for (GenericValue shiftRow : EntityQuery.use(dctx.getDelegator()).from("WanPosShift")
                            .where("terminalId", id, "statusId", "OPEN").queryList()) {
                        return ServiceUtil.returnError("Close existing shift before disabling or remapping a terminal");
                    }
                }
            }
            if (t == null) {
                t = dctx.getDelegator().makeValue("WanPosTerminal");
                t.set("terminalId", id);
            }
            boolean changedLocation = t.getString("productStoreId") != null
                    && (!store.equals(t.getString("productStoreId")) || !fac.equals(t.getString("facilityId")));
            t.set("productStoreId", store);
            t.set("facilityId", fac);
            t.set("description", string(ctx, "description"));
            t.set("enabled", Boolean.FALSE.equals(ctx.get("enabled")) ? "N" : "Y");
            // Generic terminal saves cannot enable a drawer. Remapping or disabling disarms it.
            String currentDrawerMode = t.getString("drawerMode");
            boolean remapped = changedLocation;
            t.set("drawerMode", remapped || "N".equals(t.getString("enabled"))
                    ? "MANUAL" : ("ELECTRONIC".equals(currentDrawerMode) ? "ELECTRONIC" : "MANUAL"));
            t.set("updatedByUserLoginId", who.getString("userLoginId"));
            t.set("updatedAt", new Timestamp(System.currentTimeMillis()));
            if (EntityQuery.use(dctx.getDelegator()).from("WanPosTerminal").where("terminalId", id).queryOne() == null) {
                dctx.getDelegator().create(t);
            } else {
                t.store();
            }
            audit(dctx, who, "SAVE_TERMINAL", store, fac, id, null, id, string(ctx, "requestId"), "SUCCESS");
            return ok("terminal", data(t, "terminalId", "productStoreId", "facilityId", "description", "enabled", "drawerMode"));
        } catch (Exception e) {
            return error(e);
        }
    }
    public static Map<String, Object> getTerminal(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "getTerminal");
            GenericValue t = accessibleTerminal(dctx, who, required(ctx, "terminalId"), "TERMINAL_VIEW");
            List<Map<String, Object>> devices = new ArrayList<>();
            for (GenericValue dev : EntityQuery.use(dctx.getDelegator()).from("WanPosTerminalDevice").where("terminalId",
                    t.getString("terminalId")).queryList()) {
                devices.add(data(dev, "deviceType", "connectionType", "deviceName", "portName", "settingsJson"));
            }
            Map<String, Object> out = ok("terminal", data(t, "terminalId", "productStoreId", "facilityId", "description", "enabled", "drawerMode"));
            out.put("devices", devices);
            return out;
        } catch (Exception e) {
            return error(e);
        }
    }
    /** Admin-only, facility-scoped discovery, including disabled terminals for maintenance. */
    public static Map<String, Object> listTerminals(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "listTerminals");
            String store = required(ctx, "productStoreId");
