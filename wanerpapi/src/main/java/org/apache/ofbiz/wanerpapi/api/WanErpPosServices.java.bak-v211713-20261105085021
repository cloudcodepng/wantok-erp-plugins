    /** A v3.9.6 bank-funded cash-out payout belongs to the ORIGINAL sale.
     * It is not a merchandise refund from a later failed VOID. Cross-check the
     * exact native payout metadata against the matching, immutable POS cash-out
     * movement. A request-key-linked payment is never exempted by this helper.
     */
    private static boolean isOriginalEftposCashoutPayment(Delegator delegator,
            GenericValue sale, GenericValue shift, GenericValue payment)
            throws org.apache.ofbiz.entity.GenericEntityException {
        String orderId = sale.getString("orderId");
        String payoutReference = payment.getString("paymentRefNum");
        String comments = payment.getString("comments");
        BigDecimal amount = payment.getBigDecimal("amount");
        if (!"EFTPOS".equals(sale.getString("tenderType"))
                || !"PMNT_SENT".equals(payment.getString("statusId"))
                || payoutReference == null || !payoutReference.startsWith("V396-PAYOUT-")
                // Native v3.9.6 labels the same original-sale payout with a
                // version prefix. Match only these two complete, known formats.
                // Do not use contains(orderId): that could exempt true refunds.
                || !(String.format("BANK-FUNDED CASH OUT. NOT merchandise refund; original sale=%s",
                        orderId).equals(comments)
                    || String.format("v3.9.6 BANK-FUNDED CASH OUT. NOT merchandise refund; original sale=%s",
                        orderId).equals(comments)
                    // Native v3.9.6 also emits a COMMA after OUT. Payment 10085
                    // in SHONG is this exact format (verified with read-only SQL).
                    || String.format("v3.9.6 BANK-FUNDED CASH OUT, NOT merchandise refund; original sale=%s",
                        orderId).equals(comments))
                || amount == null || amount.signum() <= 0) {
            return false;
        }
        for (GenericValue movement : EntityQuery.use(delegator).from("WanPosCashMovement")
                .where("shiftId", shift.getString("shiftId"),
                        "sourceReference", sale.getString("idempotencyKey"),
                        "movementType", "EFTPOS_CASH_OUT").queryList()) {
            BigDecimal movementAmount = movement.getBigDecimal("amount");
            if (movementAmount != null && amount.compareTo(movementAmount) == 0) {
                return true;
            }
        }
        return false;
    }

    public static Map<String, Object> resolveFailedReturnAttempt(DispatchContext dctx,
            Map<String, Object> ctx) {
        try {
            GenericValue cashier = actor(dctx, ctx, "resolveFailedReturnAttempt");
            if (!allowed(dctx, cashier, "SALE")) {
                return resolutionBlocked("CASHIER_SALE_PERMISSION");
            }
            Object confirmed = ctx.get("noPayoutConfirmed");
            if (!(Boolean.TRUE.equals(confirmed) || "true".equalsIgnoreCase(String.valueOf(confirmed)))) {
                return resolutionBlocked("NO_PAYOUT_CONFIRMATION");
            }
            Delegator delegator = dctx.getDelegator();
            String requestKey = required(ctx, "returnRequestKey");
            String saleKey = required(ctx, "originalSaleKey");
            String approvalId = required(ctx, "approvalId");
            if (!lockOriginalSaleForReturn(delegator, saleKey)) return resolutionBlocked("SALE_ROW_NOT_FOUND");
            GenericValue sale = EntityQuery.use(delegator).from("WanPosSaleRequest")
                    .where("idempotencyKey", saleKey).queryOne();
            if (sale == null || !"COMPLETED".equals(sale.getString("statusId"))) {
                return resolutionBlocked("SALE_NOT_COMPLETED");
            }
            scope(dctx, cashier, sale.getString("productStoreId"), sale.getString("facilityId"), "SALE");
            GenericValue approval = EntityQuery.use(delegator).from("WanPosRefundApproval")
                    .where("approvalId", approvalId).queryOne();
            if (approval == null || !"APPROVED".equals(approval.getString("statusId"))
                    || approval.getTimestamp("expiresAt").before(new Timestamp(System.currentTimeMillis()))
                    || !saleKey.equals(approval.getString("originalSaleKey"))
                    || !cashier.getString("userLoginId").equals(approval.getString("cashierUserLoginId"))
                    || !("RETURN".equals(approval.getString("operationCode"))
                            || "VOID".equals(approval.getString("operationCode")))
                    || !sale.getString("productStoreId").equals(approval.getString("productStoreId"))
                    || !sale.getString("facilityId").equals(approval.getString("facilityId"))) {
                return resolutionBlocked("APPROVAL_INVALID_OR_EXPIRED");
            }
            GenericValue shift = EntityQuery.use(delegator).from("WanPosShift")
                    .where("shiftId", approval.getString("shiftId")).queryOne();
            if (shift == null || !"OPEN".equals(shift.getString("statusId"))
                    || !cashier.getString("userLoginId").equals(shift.getString("cashierUserLoginId"))
                    || !approval.getString("terminalId").equals(shift.getString("terminalId"))) {
                return resolutionBlocked("SHIFT_NOT_OPEN_OR_OWNED");
            }
            WanErpPosCashControls.nativeApprover(dctx, approval);
            // The native writer and this resolver serialize on the same sale row.
            // An older return is a valid part of the sale's history. It cannot by
            // itself prove that this failed attempt posted anything. Conversely,
            // a return created during this cashier shift cannot be attributed
            // reliably to a different request if its native request key is absent.
            // Therefore only PRE-SHIFT history may be exempted; all ambiguous
            // in-shift entries fail closed. Never delete or modify existing rows.
            Timestamp shiftOpened = shift.getTimestamp("openedAt");
            if (shiftOpened == null) {
                return resolutionBlocked("SHIFT_OPENED_AT_MISSING");
            }
            String failedOperation;
            if (requestKey.startsWith("WPOS-VOID-")) {
                failedOperation = "VOID";
            } else if (requestKey.startsWith("WPOS-RETURN-")) {
                failedOperation = "RETURN";
            } else {
                return resolutionBlocked("UNKNOWN_FAILED_ATTEMPT_OPERATION");
            }
            if (EntityQuery.use(delegator).from("WanPosReturnRequest")
                    .where("returnRequestKey", requestKey).queryOne() != null) {
                return resolutionBlocked("EXACT_ATTEMPT_ALREADY_POSTED");
            }
            for (GenericValue previous : EntityQuery.use(delegator)
                    .from("WanPosReturnRequest").where("originalSaleKey", saleKey).queryList()) {
                Timestamp created = previous.getTimestamp("createdAt");
                if (created == null || !created.before(shiftOpened)) {
                    return resolutionBlocked("IN_SHIFT_POS_RETURN");
                }
            }
            for (GenericValue previous : EntityQuery.use(delegator)
                    .from("ReturnItem").where("orderId", sale.getString("orderId")).queryList()) {
                GenericValue header = EntityQuery.use(delegator).from("ReturnHeader")
                        .where("returnId", previous.getString("returnId")).queryOne();
                Timestamp created = header == null ? null : header.getTimestamp("createdStamp");
                if (created == null || !created.before(shiftOpened)) {
                    return resolutionBlocked("IN_SHIFT_NATIVE_RETURN");
                }
            }
            // Check exact failed-key movement across shifts as well; a financial
            // effect must never be overlooked because a shift was closed/reopened.
            for (GenericValue movement : EntityQuery.use(delegator).from("WanPosCashMovement")
                    .where("sourceReference", requestKey).queryList()) {
                return resolutionBlocked("EXACT_ATTEMPT_CASH_MOVEMENT");
            }
            for (GenericValue movement : EntityQuery.use(delegator).from("WanPosCashMovement")
                    .where("shiftId", shift.getString("shiftId")).queryList()) {
                String source = movement.getString("sourceReference");
                // An EFTPOS cashback withdrawal belongs to the original sale,
                // not to this failed VOID/return attempt. Keep it in the ledger.
                // NEVER disregard movements attributed to the attempted request.
                String movementType = movement.getString("movementType");
                boolean originalSaleMovement = saleKey.equals(source)
                        && ("CASH_SALE".equals(movementType)
                                || "EFTPOS_CASH_OUT".equals(movementType));
                if ((requestKey.equals(source) || saleKey.equals(source))
                        && !originalSaleMovement) {
                    return resolutionBlocked("EXISTING_CASH_MOVEMENT");
                }
            }
            // Detect orphan native refund payments that carry the originating
            // return key/order reference; a genuine external payout remains subject
            // to cashier's explicit witnessed no-payout attestation above.
            for (GenericValue payment : EntityQuery.use(delegator).from("Payment")
                    .where("paymentTypeId", "CUSTOMER_REFUND").queryList()) {
                String reference = payment.getString("paymentRefNum");
                String comments = payment.getString("comments");
                boolean matchesAttemptOrSaleReference = reference != null
                        && (reference.contains(requestKey) || reference.contains(saleKey));
                boolean mentionsOriginalOrder = comments != null
                        && comments.contains(sale.getString("orderId"));
                boolean exactAttempt = reference != null && reference.contains(requestKey);
                // A previously completed merchandise refund can legitimately be
                // referenced by the order. Only payments proven to predate the
                // current shift are historical; missing timestamps fail closed.
                Timestamp paymentCreated = payment.getTimestamp("createdStamp");
                boolean priorHistory = paymentCreated != null && paymentCreated.before(shiftOpened);
                if (exactAttempt || ((matchesAttemptOrSaleReference || mentionsOriginalOrder)
                        && !priorHistory && !isOriginalEftposCashoutPayment(
                                delegator, sale, shift, payment))) {
                    return resolutionBlocked("EXISTING_REFUND_PAYMENT");
                }
            }
            GenericValue existing = EntityQuery.use(delegator).from("WanPosRefundAttemptResolution")
                    .where("returnRequestKey", requestKey).queryOne();
            if (existing != null) {
                if (!saleKey.equals(existing.getString("originalSaleKey"))
                        || !cashier.getString("userLoginId").equals(existing.getString("cashierUserLoginId"))
                        || !approvalId.equals(existing.getString("approvalId"))) {
                    return resolutionBlocked("RESOLUTION_KEY_CONFLICT");
                }
                Map<String, Object> previous = ServiceUtil.returnSuccess();
                previous.put("statusId", "RESOLVED_NO_EFFECT");
                previous.put("resolvedRequestKey", requestKey);
                return previous;
            }
            GenericValue row = delegator.makeValue("WanPosRefundAttemptResolution");
            row.set("returnRequestKey", requestKey);
            row.set("originalSaleKey", saleKey);
            row.set("approvalId", approvalId);
            row.set("cashierUserLoginId", cashier.getString("userLoginId"));
            row.set("approvedByUserLoginId", approval.getString("approvedByUserLoginId"));
            row.set("productStoreId", sale.getString("productStoreId"));
            row.set("facilityId", sale.getString("facilityId"));
            row.set("terminalId", shift.getString("terminalId"));
            row.set("shiftId", shift.getString("shiftId"));
            row.set("statusId", "RESOLVED_NO_EFFECT");
            row.set("noPayoutConfirmed", "Y");
            row.set("resolvedAt", new Timestamp(System.currentTimeMillis()));
            delegator.create(row);
            audit(dctx, cashier, "VOID".equals(failedOperation)
                    ? "RESOLVE_FAILED_VOID" : "RESOLVE_FAILED_RETURN", sale.getString("productStoreId"),
                    sale.getString("facilityId"), shift.getString("terminalId"),
                    shift.getString("shiftId"), requestKey, string(ctx, "requestId"), "SUCCESS");
            Map<String, Object> result = ServiceUtil.returnSuccess();
            result.put("statusId", "RESOLVED_NO_EFFECT");
            result.put("resolvedRequestKey", requestKey);
            result.put("resolvedOperation", failedOperation);
            return result;
        } catch (Exception e) {
            org.apache.ofbiz.base.util.Debug.logWarning(
                    "WANERP POS refund resolution failed with " + e.getClass().getSimpleName(),
                    "WanErpPosServices");
            return error(e);
        }
    }

    /** Only an authenticated SALE actor for the original store can resolve a manager badge. */
    public static Map<String, Object> resolveManagerBadge(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue cashier = actor(dctx, ctx, "resolveManagerBadge");
            GenericValue sale = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                    .where("idempotencyKey", required(ctx, "originalSaleKey")).queryOne();
            if (sale == null) {
                return denied();
            }
            scope(dctx, cashier, sale.getString("productStoreId"), sale.getString("facilityId"), "SALE");
            String username = WanErpPosManagerBadges.resolve(dctx, required(ctx, "badgeValue"),
                    sale.getString("productStoreId"), sale.getString("facilityId"));
            GenericValue manager = EntityQuery.use(dctx.getDelegator()).from("UserLogin")
                    .where("userLoginId", username).queryOne();
            if (manager == null || "N".equalsIgnoreCase(manager.getString("enabled"))
                    || !badgeManagerRole(dctx, manager)
                    || !approvedManagerRights(dctx, manager)
                    || !grant(dctx.getDelegator(), username, sale.getString("productStoreId"),
                            sale.getString("facilityId"), "MANAGE")) {
                return denied();
            }
            return ok("managerUserLoginId", username);
        } catch (Exception e) {
            return error(e);
        }
    }

