    public static Map<String, Object> saveScaleProfile(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "saveScaleProfile");
            String id = required(ctx, "scaleId");
            String store = required(ctx, "productStoreId");
            scope(dctx, who, store, null, "TERMINAL_ADMIN");
            String prefix = string(ctx, "prefix");
            if (prefix == null || !prefix.matches("[0-9]{2}")) {
                return denied();
            }
            for (String field : List.of("pluDigits", "weightDigits", "weightDecimals")) {
                if (!(ctx.get(field) instanceof Long) || (Long) ctx.get(field) < 0 || (Long) ctx.get(field) > 10) {
                    return denied();
                }
            }
            GenericValue p = EntityQuery.use(dctx.getDelegator()).from("WanPosScaleProfile").where("scaleId", id).queryOne();
            boolean create = p == null;
            if (create) {
                p = dctx.getDelegator().makeValue("WanPosScaleProfile");
                p.set("scaleId", id);
            } else if (!store.equals(p.getString("productStoreId"))) {
                return denied();
            }
            p.set("productStoreId", store);
            p.set("prefix", prefix);
            p.set("pluDigits", ctx.get("pluDigits"));
            p.set("weightDigits", ctx.get("weightDigits"));
            p.set("weightDecimals", ctx.get("weightDecimals"));
            // A typed flag is not proof of physical sticker format validation: always reset.
            p.set("validated", "N");
            p.set("updatedAt", new Timestamp(System.currentTimeMillis()));
            if (create) {
                dctx.getDelegator().create(p);
            } else {
                p.store();
            }
            audit(dctx, who, "SCALE_PROFILE", store, null, null, null, id, string(ctx, "requestId"), "SUCCESS");
            return ok("profile", data(p, "scaleId", "productStoreId", "prefix", "pluDigits", "weightDigits", "weightDecimals", "validated"));
        } catch (Exception e) {
            return error(e);
        }
    }
    public static Map<String, Object> saveScalePlu(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "saveScalePlu");
            GenericValue profile = EntityQuery.use(dctx.getDelegator()).from("WanPosScaleProfile")
                    .where("scaleId", required(ctx, "scaleId")).queryOne();
            if (profile == null) {
                return denied();
            }
            scope(dctx, who, profile.getString("productStoreId"), null, "TERMINAL_ADMIN");
            String plu = required(ctx, "pluCode");
            String product = required(ctx, "productId");
            if (!plu.matches("[0-9]{1,8}") || EntityQuery.use(dctx.getDelegator()).from("Product").where("productId", product).queryOne() == null) {
                return denied();
            }
            GenericValue p = EntityQuery.use(dctx.getDelegator()).from("WanPosScalePluMap").where("scaleId", profile.getString("scaleId"),
                    "pluCode", plu).queryOne();
            boolean create = p == null;
            if (create) {
                p = dctx.getDelegator().makeValue("WanPosScalePluMap");
                p.set("scaleId", profile.getString("scaleId"));
                p.set("pluCode", plu);
            }
            // Changing a mapped product invalidates prior two-label physical approval.
            if (!create && (!product.equals(p.getString("productId")) || !"Y".equals(p.getString("enabled")))) {
                profile.set("validated", "N");
                profile.set("updatedAt", new Timestamp(System.currentTimeMillis()));
                profile.store();
            } else if (create) {
                profile.set("validated", "N");
                profile.set("updatedAt", new Timestamp(System.currentTimeMillis()));
                profile.store();
            }
            p.set("productId", product);
            p.set("enabled", "Y");
            p.set("updatedAt", new Timestamp(System.currentTimeMillis()));
            if (create) {
                dctx.getDelegator().create(p);
            } else {
                p.store();
