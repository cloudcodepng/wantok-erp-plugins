    /** Bounded administrative reference data, never a generic OFBiz entity browser. */
    public static Map<String, Object> listAdminOptions(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "listAdminOptions");
            String store = required(ctx, "productStoreId");
            String fac = required(ctx, "facilityId");
            scope(dctx, who, store, fac, "TERMINAL_ADMIN");
            String kind = required(ctx, "kind");
            String query = string(ctx, "query");
            String needle = query == null ? "" : query.trim().toLowerCase(Locale.ROOT);
            if (needle.length() > 80) {
                return denied();
            }
            long requestedLimit = ctx.get("maxRows") instanceof Number
                    ? ((Number) ctx.get("maxRows")).longValue() : 40L;
            if (requestedLimit < 1 || requestedLimit > 100) {
                return denied();
            }
            int limit = (int) requestedLimit;
            List<Map<String, Object>> options = new ArrayList<>();
            Delegator d = dctx.getDelegator();
            if ("PRODUCTS".equals(kind) || "WEIGHTED_PRODUCTS".equals(kind)) {
                // Tenant delegator isolation + verified store/facility administrative grant.
                for (GenericValue row : EntityQuery.use(d).from("Product")
                        .orderBy("productId").maxRows(2000).queryList()) {
                    String productId = row.getString("productId");
                    if (productId == null || ("WEIGHTED_PRODUCTS".equals(kind)
                            && !"WT_kg".equals(row.getString("quantityUomId")))) {
                        continue;
                    }
                    String name = row.getString("productName");
                    if (name == null || name.isBlank()) {
                        name = row.getString("internalName");
                    }
                    if (name == null) {
                        name = productId;
                    }
                    if (!needle.isEmpty() && !(productId.toLowerCase(Locale.ROOT).contains(needle)
                            || name.toLowerCase(Locale.ROOT).contains(needle))) {
                        continue;
                    }
                    Map<String, Object> option = new LinkedHashMap<>();
                    option.put("value", productId);
                    option.put("label", name + " (" + productId + ")");
                    option.put("productName", name);
                    option.put("quantityUomId", row.getString("quantityUomId"));
                    options.add(option);
                    if (options.size() >= limit) {
                        break;
                    }
                }
            } else if ("STAFF".equals(kind) || "BADGE_MANAGER".equals(kind)) {
                String tenantPrefix = tenant(d).toLowerCase(Locale.ROOT) + ".";
                for (GenericValue row : EntityQuery.use(d).from("UserLogin")
                        .orderBy("userLoginId").maxRows(2000).queryList()) {
                    String login = row.getString("userLoginId");
                    if (login == null || !login.toLowerCase(Locale.ROOT).startsWith(tenantPrefix)) {
                        continue;
                    }
                    if ("N".equals(row.getString("enabled"))) {
                        continue;
                    }
                    if ("BADGE_MANAGER".equals(kind)
                            && (!badgeManagerRole(dctx, row) || !approvedManagerRights(dctx, row)
                            || !grant(d, login, store, fac, "MANAGE"))) {
                        continue;
                    }
                    String name = login;
                    String partyId = row.getString("partyId");
                    if (partyId != null) {
                        GenericValue person = EntityQuery.use(d).from("Person")
                                .where("partyId", partyId).queryOne();
                        if (person != null) {
                            String first = person.getString("firstName");
                            String last = person.getString("lastName");
                            String full = ((first == null ? "" : first) + " " + (last == null ? "" : last)).trim();
                            if (!full.isEmpty()) {
                                name = full;
                            }
                        }
                    }
                    if (!needle.isEmpty() && !(login.toLowerCase(Locale.ROOT).contains(needle)
                            || name.toLowerCase(Locale.ROOT).contains(needle))) {
                        continue;
                    }
                    Map<String, Object> option = new LinkedHashMap<>();
                    option.put("value", login);
                    option.put("label", name + " (" + login + ")");
                    options.add(option);
                    if (options.size() >= limit) {
                        break;
                    }
                }
            } else {
                return denied();
            }
            return ok("options", options);
        } catch (Exception e) {
            return error(e);
        }
    }

    public static Map<String, Object> saveDevice(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "saveDevice");
            GenericValue t = accessibleTerminal(dctx, who, required(ctx, "terminalId"), "TERMINAL_ADMIN");
            String kind = required(ctx, "deviceType");
            if (!Set.of("SCANNER", "PRINTER", "DRAWER", "SCALE", "EFTPOS").contains(kind)) {
                return denied();
            }
            String settings = string(ctx, "settingsJson");
            if (settings != null && settings.length() > 4096) {
                return denied();
            }
            String connection = required(ctx, "connectionType");
            if (!deviceConnectionAllowed(kind, connection)
                    || (settings != null && (!settingsSafe(settings) || !deviceAdapterAllowed(kind, settings)))) {
                return denied();
            }
            // Electronic drawer activation is exclusively via setDrawerMode, never saveDevice.
            if ("DRAWER".equals(kind) && "PRINTER_KICK".equals(connection)
                    && (settings == null || !settings.contains("drawer-printer-kick"))) {
                return denied();
            }
            // The bank device is standalone: portName records the bank receipt TID, not a TCP/USB port.
            if ("EFTPOS".equals(kind) && (!"STANDALONE".equals(string(ctx, "connectionType"))
                    || string(ctx, "portName") == null
                    || !string(ctx, "portName").matches("[A-Za-z0-9_.:-]{3,56}")
                    || (settings != null && !settings.isBlank() && !settings.contains("standalone-eftpos")))) {
                return denied();
            }
            GenericValue v = EntityQuery.use(dctx.getDelegator()).from("WanPosTerminalDevice")
                    .where("terminalId", t.getString("terminalId"), "deviceType", kind).queryOne();
            boolean create = v == null;
            if (create) {
                v = dctx.getDelegator().makeValue("WanPosTerminalDevice");
                v.set("terminalId", t.getString("terminalId"));
                v.set("deviceType", kind);
            }
            v.set("connectionType", connection);
            v.set("deviceName", string(ctx, "deviceName"));
            v.set("portName", string(ctx, "portName"));
            v.set("settingsJson", settings);
            v.set("updatedAt", new Timestamp(System.currentTimeMillis()));
            if (create) {
                dctx.getDelegator().create(v);
            } else {
                v.store();
            }
            // Any printer/drawer hardware change revokes prior electronic drawer approval.
            if (("DRAWER".equals(kind) || "PRINTER".equals(kind))
                    && "ELECTRONIC".equals(t.getString("drawerMode"))) {
                t.set("drawerMode", "MANUAL");
                t.set("updatedByUserLoginId", who.getString("userLoginId"));
                t.set("updatedAt", new Timestamp(System.currentTimeMillis()));
                t.store();
            }
            audit(dctx, who, "SAVE_DEVICE", t.getString("productStoreId"), t.getString("facilityId"), t.getString("terminalId"), null,
                    kind, string(ctx, "requestId"), "SUCCESS");
            return ok("device", data(v, "terminalId", "deviceType", "connectionType", "deviceName", "portName", "settingsJson"));
        } catch (Exception e) {
            return error(e);
        }
    }
    /** Strict supported transport allowlist; each terminal has one primary device per type in v2.1. */
    private static boolean deviceConnectionAllowed(String type, String connection) {
        switch (type) {
        case "SCANNER": return Set.of("USB", "KEYBOARD", "RS232", "SERIAL").contains(connection);
        case "PRINTER": return Set.of("USB", "LAN", "QZ").contains(connection);
        case "SCALE": return Set.of("BARCODE", "LAN", "USB").contains(connection);
        case "DRAWER": return Set.of("MANUAL", "PRINTER_KICK").contains(connection);
        case "EFTPOS": return "STANDALONE".equals(connection);
        default: return false;
        }
    }
    private static boolean settingsSafe(String settings) {
        if (settings.length() > 4096 || !settings.isBlank()
                && (!settings.trim().startsWith("{") || !settings.trim().endsWith("}"))) {
            return false;
        }
        String value = settings.toLowerCase(Locale.ROOT);
        for (int i = 0; i < settings.length(); i++) {
            if (settings.charAt(i) < 0x20) return false;
        }
        for (String forbidden : Set.of("password", "secret", "privatekey", "private_key", "accesstoken", "refreshtoken", "actorproof")) {
            if (value.contains(forbidden)) return false;
        }
        return true;
    }
    private static boolean deviceAdapterAllowed(String type, String settings) {
        if (settings.isBlank()) return true; // legacy configurations remain readable; gateway will fail closed on activation
        if (!settings.contains("\"adapterId\"")) return false;
        switch (type) {
        case "SCANNER": return settings.contains("web-serial") || settings.contains("keyboard-wedge");
        case "PRINTER": return settings.contains("qz-escpos");
        case "SCALE": return settings.contains("barcode-label");
        case "DRAWER": return settings.contains("drawer-manual") || settings.contains("drawer-printer-kick");
        case "EFTPOS": return settings.contains("standalone-eftpos");
        default: return false;
        }
    }

    /** Separately audited, deliberate electronic drawer arming; never fires a physical pulse. */
    public static Map<String, Object> setDrawerMode(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "setDrawerMode");
            GenericValue t = accessibleTerminal(dctx, who, required(ctx, "terminalId"), "TERMINAL_ADMIN");
            if (!admin(dctx, who)) return denied();
            String mode = required(ctx, "drawerMode");
            if (!Set.of("MANUAL", "ELECTRONIC").contains(mode)) return denied();
            String reason = string(ctx, "reason");
            if (reason == null || reason.trim().length() < 10 || reason.length() > 240) return denied();
            if ("ELECTRONIC".equals(mode)) {
                if (!Boolean.TRUE.equals(ctx.get("physicalTestConfirmed")) || !"Y".equals(t.getString("enabled"))) return denied();
                GenericValue printer = EntityQuery.use(dctx.getDelegator()).from("WanPosTerminalDevice")
                        .where("terminalId", t.getString("terminalId"), "deviceType", "PRINTER").queryOne();
                GenericValue drawer = EntityQuery.use(dctx.getDelegator()).from("WanPosTerminalDevice")
                        .where("terminalId", t.getString("terminalId"), "deviceType", "DRAWER").queryOne();
                if (printer == null || drawer == null || !"PRINTER_KICK".equals(drawer.getString("connectionType"))
                        || printer.getString("settingsJson") == null || !printer.getString("settingsJson").contains("qz-escpos")
                        || drawer.getString("settingsJson") == null || !drawer.getString("settingsJson").contains("drawer-printer-kick")) {
                    return denied();
                }
                for (GenericValue shift : EntityQuery.use(dctx.getDelegator()).from("WanPosShift")
                        .where("terminalId", t.getString("terminalId"), "statusId", "OPEN").queryList()) {
                    return ServiceUtil.returnError("Close active shift before activating electronic drawer");
                }
            }
            t.set("drawerMode", mode);
            t.set("updatedByUserLoginId", who.getString("userLoginId"));
            t.set("updatedAt", new Timestamp(System.currentTimeMillis()));
            t.store();
            audit(dctx, who, "SET_DRAWER_MODE", t.getString("productStoreId"), t.getString("facilityId"),
                    t.getString("terminalId"), null, mode, string(ctx, "requestId"), "SUCCESS");
            return ok("terminal", data(t, "terminalId", "productStoreId", "facilityId", "enabled", "drawerMode"));
        } catch (Exception e) {
            return error(e);
        }
    }
