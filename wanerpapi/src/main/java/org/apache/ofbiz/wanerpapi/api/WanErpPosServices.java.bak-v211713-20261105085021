    /** Read-only idempotent recovery: a browser marker is not proof of financial posting. */
    public static Map<String, Object> getReturnRequestStatus(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue cashier = actor(dctx, ctx, "getReturnRequestStatus");
            GenericValue ret = EntityQuery.use(dctx.getDelegator()).from("WanPosReturnRequest")
                    .where("returnRequestKey", required(ctx, "returnRequestKey")).queryOne();
            if (ret == null) {
                GenericValue resolved = EntityQuery.use(dctx.getDelegator())
                        .from("WanPosRefundAttemptResolution")
                        .where("returnRequestKey", required(ctx, "returnRequestKey")).queryOne();
                if (resolved != null) {
                    if (!cashier.getString("userLoginId").equals(resolved.getString("cashierUserLoginId"))) {
                        return denied();
                    }
                    scope(dctx, cashier, resolved.getString("productStoreId"),
                            resolved.getString("facilityId"), "SALE");
                    Map<String, Object> closed = ServiceUtil.returnSuccess();
                    closed.put("found", false);
                    closed.put("statusId", "RESOLVED_NO_EFFECT");
                    closed.put("retryAuthorized", false);
                    closed.put("originalSaleKey", resolved.getString("originalSaleKey"));
                    return closed;
                }
                Map<String, Object> none = ServiceUtil.returnSuccess();
                none.put("found", false);
                // Absence of a committed row cannot establish that an earlier
                // transaction was never dispatched or is not still in flight.
                none.put("statusId", "UNKNOWN");
                none.put("retryAuthorized", false);
                return none;
            }
            GenericValue sale = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                    .where("idempotencyKey", ret.getString("originalSaleKey")).queryOne();
            if (sale == null) {
                return denied();
            }
            scope(dctx, cashier, sale.getString("productStoreId"), sale.getString("facilityId"), "SALE");
            if (!cashier.getString("userLoginId").equals(ret.getString("actorUserLoginId"))) {
                return denied();
            }
            Map<String, Object> response = ServiceUtil.returnSuccess();
            response.put("found", true);
            response.put("retryAuthorized", false);
            response.put("returnRequestKey", ret.getString("returnRequestKey"));
            response.put("originalSaleKey", ret.getString("originalSaleKey"));
            response.put("statusId", ret.getString("statusId"));
            response.put("totalRefund", ret.getBigDecimal("totalRefund"));
            response.put("creditInvoiceId", ret.getString("creditInvoiceId"));
            return response;
        } catch (Exception e) {
            return error(e);
        }
    }

