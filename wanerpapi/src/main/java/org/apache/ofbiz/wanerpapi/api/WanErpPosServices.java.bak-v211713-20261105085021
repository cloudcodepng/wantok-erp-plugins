    /**
     * Physically observed, two-PLU barcode approval. A signed manager/admin
     * attests that BOTH barcodes were captured from the real scale and each
     * independently observed kilogram weight matches the label. No sample
     * generator, fake sale or synthetic decoder is involved.
     */
    public static Map<String, Object> approveScaleProfile(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "approveScaleProfile");
            String scaleId = required(ctx, "scaleId");
            GenericValue t = terminal(dctx.getDelegator(), required(ctx, "terminalId"));
            scope(dctx, who, t.getString("productStoreId"), t.getString("facilityId"), "TERMINAL_ADMIN");
            for (GenericValue shift : EntityQuery.use(dctx.getDelegator()).from("WanPosShift")
                    .where("terminalId", t.getString("terminalId"), "statusId", "OPEN").queryList()) {
                return ServiceUtil.returnError("Close active shift before approving scale profile");
            }
            if (!Boolean.TRUE.equals(ctx.get("physicalTestConfirmed"))) {
                return ServiceUtil.returnError("Physical scale verification required");
            }
            String reason = string(ctx, "reason");
            if (reason == null || reason.trim().length() < 12 || reason.length() > 180) {
                return ServiceUtil.returnError("Physical test reason required");
            }
            GenericValue profile = EntityQuery.use(dctx.getDelegator()).from("WanPosScaleProfile")
                    .where("scaleId", scaleId).queryOne();
            if (profile == null || !t.getString("productStoreId").equals(profile.getString("productStoreId"))) {
                return denied();
            }
            GenericValue scaleDevice = EntityQuery.use(dctx.getDelegator()).from("WanPosTerminalDevice")
                    .where("terminalId", t.getString("terminalId"), "deviceType", "SCALE").queryOne();
            String config = scaleDevice == null ? null : scaleDevice.getString("settingsJson");
            if (config == null || !config.contains("\"adapterId\":\"barcode-label\"")
                    || !config.contains("\"scaleId\":\"" + scaleId + "\"")) {
                return ServiceUtil.returnError("Scale device binding is not configured");
            }
            String barcodeA = required(ctx, "barcodeA");
            String barcodeB = required(ctx, "barcodeB");
            if (!barcodeA.matches("[0-9]{13}") || !barcodeB.matches("[0-9]{13}")
                    || barcodeA.equals(barcodeB) || !gtinValid(barcodeA) || !gtinValid(barcodeB)) {
                return ServiceUtil.returnError("Two distinct genuine EAN-13 labels required");
            }
            Object measuredA = ctx.get("referenceWeightKgA");
            Object measuredB = ctx.get("referenceWeightKgB");
            if (!(measuredA instanceof BigDecimal) || !(measuredB instanceof BigDecimal)) {
                return ServiceUtil.returnError("Measured reference weights required");
            }
            BigDecimal referenceA = (BigDecimal) measuredA;
            BigDecimal referenceB = (BigDecimal) measuredB;
            if (referenceA.signum() <= 0 || referenceB.signum() <= 0) {
                return ServiceUtil.returnError("Reference weights must be positive");
            }
            Map<String, Object> first = lookupScaleBarcode(dctx, who, t, barcodeA);
            Map<String, Object> second = lookupScaleBarcode(dctx, who, t, barcodeB);
            if (!ServiceUtil.isSuccess(first) || !ServiceUtil.isSuccess(second)) {
                return ServiceUtil.returnError("Physical labels cannot be decoded or priced");
            }
            @SuppressWarnings("unchecked")
            Map<String, Object> a = (Map<String, Object>) first.get("product");
            @SuppressWarnings("unchecked")
            Map<String, Object> b = (Map<String, Object>) second.get("product");
            if (a == null || b == null || !scaleId.equals(a.get("scaleId")) || !scaleId.equals(b.get("scaleId"))
                    || a.get("pluCode").equals(b.get("pluCode"))
                    || ((BigDecimal) a.get("quantity")).subtract(referenceA).abs().compareTo(new BigDecimal("0.005")) > 0
                    || ((BigDecimal) b.get("quantity")).subtract(referenceB).abs().compareTo(new BigDecimal("0.005")) > 0) {
                return ServiceUtil.returnError("Measured weight or distinct scale PLU does not match");
            }
            profile.set("validated", "Y");
            profile.set("updatedAt", new Timestamp(System.currentTimeMillis()));
            profile.store();
            GenericValue auditEntry = dctx.getDelegator().makeValue("WanPosAudit");
            auditEntry.set("auditId", dctx.getDelegator().getNextSeqId("WanPosAudit"));
            auditEntry.set("eventAt", new Timestamp(System.currentTimeMillis()));
            auditEntry.set("actorUserLoginId", who.getString("userLoginId"));
            auditEntry.set("actorPartyId", who.getString("partyId"));
            auditEntry.set("productStoreId", t.getString("productStoreId"));
            auditEntry.set("facilityId", t.getString("facilityId"));
            auditEntry.set("terminalId", t.getString("terminalId"));
            auditEntry.set("action", "SCALE_APPROVE");
            auditEntry.set("entityId", scaleId);
            auditEntry.set("requestId", string(ctx, "requestId"));
            auditEntry.set("outcome", "SUCCESS");
            byte[] digestA = MessageDigest.getInstance("SHA-256").digest(barcodeA.getBytes(StandardCharsets.US_ASCII));
            byte[] digestB = MessageDigest.getInstance("SHA-256").digest(barcodeB.getBytes(StandardCharsets.US_ASCII));
            auditEntry.set("reason", reason.trim() + " barcodeHashes="
                    + Base64.getUrlEncoder().withoutPadding().encodeToString(digestA).substring(0, 12) + ","
                    + Base64.getUrlEncoder().withoutPadding().encodeToString(digestB).substring(0, 12));
            dctx.getDelegator().create(auditEntry);
            return ok("profile", data(profile, "scaleId", "productStoreId", "prefix", "pluDigits",
                    "weightDigits", "weightDecimals", "validated"));
        } catch (Exception e) {
            return error(e);
        }
    }
