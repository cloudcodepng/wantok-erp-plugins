    private static void financeScope(DispatchContext dctx, GenericValue accountant, GenericValue sale)
            throws Exception {
        scope(dctx, accountant, sale.getString("productStoreId"), sale.getString("facilityId"),
                "EFTPOS_RECONCILE");
        if (!groups(dctx.getDelegator(), accountant.getString("userLoginId"))
                .contains(tenant(dctx.getDelegator()).toUpperCase(Locale.ROOT) + "_ACCOUNTANT")) {
            throw new IllegalArgumentException("Accountant role required");
        }
        if (accountant.getString("userLoginId").equals(sale.getString("actorUserLoginId"))) {
            throw new IllegalArgumentException("Self reconciliation prohibited");
        }
    }

    private static GenericValue eftposSale(DispatchContext dctx, String key) throws Exception {
        GenericValue sale = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                .where("idempotencyKey", key).queryOne();
        if (sale == null || !"COMPLETED".equals(sale.getString("statusId"))
                || sale.getBigDecimal("eftposReceiptAmount") == null
                || sale.getBigDecimal("eftposReceiptAmount").signum() <= 0
                || !"CASHIER_ATTESTED".equals(sale.getString("eftposEvidenceStatus"))
                || sale.getString("paymentId") == null || sale.getString("orderId") == null
                || sale.getString("invoiceId") == null) {
            throw new IllegalArgumentException("Completed EFTPOS sale required");
        }
        return sale;
    }

    public static Map<String, Object> listEftposReconciliation(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue accountant = actor(dctx, ctx, "listEftposReconciliation");
            String store = required(ctx, "productStoreId");
            String facility = required(ctx, "facilityId");
            scope(dctx, accountant, store, facility, "EFTPOS_RECONCILE");
            if (!groups(dctx.getDelegator(), accountant.getString("userLoginId"))
                    .contains(tenant(dctx.getDelegator()).toUpperCase(Locale.ROOT) + "_ACCOUNTANT")) {
                return denied();
            }
            int limit = 50;
            if (ctx.get("maxRows") instanceof Number) {
                limit = Math.max(1, Math.min(100, ((Number) ctx.get("maxRows")).intValue()));
            }
            List<Map<String, Object>> rows = new ArrayList<>();
            for (GenericValue sale : EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                    .where("productStoreId", store, "facilityId", facility, "statusId", "COMPLETED")
                    .orderBy("-createdAt").maxRows(2000).queryList()) {
                String status = sale.getString("eftposReconciliationStatus");
                if (!("PENDING".equals(status) || "DISCREPANCY".equals(status))
                        || sale.getBigDecimal("eftposReceiptAmount") == null
                        || sale.getBigDecimal("eftposReceiptAmount").signum() <= 0
                        || accountant.getString("userLoginId").equals(sale.getString("actorUserLoginId"))) {
                    continue;
                }
                rows.add(eftposSummary(sale));
                if (rows.size() >= limit) break;
            }
            return ok("sales", rows);
        } catch (Exception e) {
            return error(e);
        }
    }

    public static Map<String, Object> getEftposReconciliation(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue accountant = actor(dctx, ctx, "getEftposReconciliation");
            GenericValue sale = eftposSale(dctx, required(ctx, "idempotencyKey"));
            financeScope(dctx, accountant, sale);
            List<Map<String, Object>> history = new ArrayList<>();
            for (GenericValue attempt : EntityQuery.use(dctx.getDelegator()).from("WanPosEftposReconciliation")
                    .where("idempotencyKey", sale.getString("idempotencyKey"))
                    .orderBy("recordedAt").maxRows(50).queryList()) {
                history.add(data(attempt, "reconciliationKey", "decision", "evidenceSource",
                        "settlementReference", "settlementDate", "expectedAmount", "settledAmount",
                        "actorUserLoginId", "reason", "recordedAt"));
            }
            Map<String, Object> result = ok("sale", eftposSummary(sale));
            result.put("history", history);
            return result;
        } catch (Exception e) {
            return error(e);
        }
    }

    private static String evidenceText(Map<String, Object> ctx, String field, int max) {
        String value = string(ctx, field);
        if (value == null || value.length() > max || !value.matches("[A-Za-z0-9_.:-]{2,}")) {
            throw new IllegalArgumentException("Invalid bank evidence");
        }
        return value;
    }

    private static BigDecimal settlementMoney(Object value) {
        if (value == null) throw new IllegalArgumentException("Missing settlement amount");
        BigDecimal n = new BigDecimal(value.toString());
        if (n.signum() < 0 || n.scale() > 2 || n.compareTo(new BigDecimal("100000000")) > 0) {
            throw new IllegalArgumentException("Invalid settlement amount");
        }
        return n.setScale(2, java.math.RoundingMode.UNNECESSARY);
    }

    private static String reconHash(String raw) throws Exception {
        byte[] sha = MessageDigest.getInstance("SHA-256").digest(raw.getBytes(StandardCharsets.UTF_8));
        StringBuilder hex = new StringBuilder(sha.length * 2);
        for (byte b : sha) hex.append(String.format("%02x", b & 0xff));
        return hex.toString();
    }

    /** A bank statement/batch comparison, not a new payment or an OFBiz accounting posting.
     * Idempotent per reconciliationKey. The reconciliation ledger is append-only.
     * The native sale row's reconciliation status is the current projection of these decisions.
     */
    public static Map<String, Object> confirmEftposReconciliation(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue accountant = actor(dctx, ctx, "confirmEftposReconciliation");
            String saleKey = required(ctx, "idempotencyKey");
            String reviewKey = required(ctx, "reconciliationKey");
            String decision = required(ctx, "decision");
            String source = required(ctx, "evidenceSource");
            if (!Set.of("MATCHED", "DISCREPANCY").contains(decision)
                    || !Set.of("BANK_BATCH", "BANK_STATEMENT", "BANK_PORTAL").contains(source)
                    || !Boolean.TRUE.equals(ctx.get("evidenceVerified"))) {
                return denied();
            }
            String rrn = evidenceText(ctx, "rrn", 40);
            String code = evidenceText(ctx, "approvalCode", 20);
            String bankTerminal = evidenceText(ctx, "bankTerminalId", 56);
            String batch = evidenceText(ctx, "settlementReference", 80);
            String day = string(ctx, "settlementDate");
            if (day == null || !day.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")) return denied();
            java.sql.Date date = java.sql.Date.valueOf(day);
            if (date.after(new java.sql.Date(System.currentTimeMillis()))) return denied();
            BigDecimal observed = settlementMoney(ctx.get("settledAmount"));
            String reason = string(ctx, "reason");
            if (reason == null || reason.trim().length() < 10 || reason.length() > 240
                    || reason.chars().anyMatch(c -> c < 32)) return denied();
            String fingerprint = reconHash(String.join("|", saleKey, decision, source, rrn, code,
                    bankTerminal, batch, day, observed.toPlainString(), reason.trim()));
            Delegator d = dctx.getDelegator();
            // Serialize all decisions for this sale within the transactional OFBiz service.
            // EntityQuery has no forUpdate() in OFBiz 24.09; SQLProcessor uses the
            // tenant's same JTA-enlisted datasource connection. The lock is held
            // until commit/rollback of this service, not merely the SELECT.
            try (SQLProcessor sql = new SQLProcessor(d,
                    d.getGroupHelperInfo(d.getEntityGroupName("WanPosSaleRequest")))) {
                sql.prepareStatement("SELECT IDEMPOTENCY_KEY FROM WAN_POS_SALE_REQUEST "
                        + "WHERE IDEMPOTENCY_KEY = ? FOR UPDATE");
                sql.setValue(saleKey);
                try (ResultSet locked = sql.executeQuery()) {
                    if (!locked.next()) return denied();
                }
                // Check AFTER taking the lock; a parallel identical request
                // might have committed while this request was waiting.
                GenericValue previous = EntityQuery.use(d).from("WanPosEftposReconciliation")
                        .where("reconciliationKey", reviewKey).queryOne();
                if (previous != null) {
                    financeScope(dctx, accountant, eftposSale(dctx, saleKey));
                    if (!saleKey.equals(previous.getString("idempotencyKey"))
                            || !fingerprint.equals(previous.getString("requestFingerprint"))
                            || !accountant.getString("userLoginId").equals(previous.getString("actorUserLoginId"))) {
                        return denied();
                    }
                    return ok("reconciliation", data(previous, "reconciliationKey", "idempotencyKey",
                            "decision", "settledAmount", "settlementReference", "actorUserLoginId", "recordedAt"));
                }
                GenericValue sale = EntityQuery.use(d).from("WanPosSaleRequest")
                        .where("idempotencyKey", saleKey).queryOne();
                if (sale == null || !"COMPLETED".equals(sale.getString("statusId"))
                        || sale.getBigDecimal("eftposReceiptAmount") == null
                        || !"CASHIER_ATTESTED".equals(sale.getString("eftposEvidenceStatus"))
                        || sale.getString("paymentId") == null || sale.getString("invoiceId") == null
                        || sale.getString("orderId") == null) return denied();
                financeScope(dctx, accountant, sale);
                String prior = sale.getString("eftposReconciliationStatus");
                if (!Set.of("PENDING", "DISCREPANCY").contains(prior)) return denied();
                BigDecimal expected = settlementMoney(sale.getBigDecimal("eftposReceiptAmount"));
                boolean evidenceMatches = expected.compareTo(observed) == 0
                        && rrn.equalsIgnoreCase(sale.getString("eftposReference"))
                        && code.equalsIgnoreCase(sale.getString("eftposApprovalCode"))
                        && bankTerminal.equalsIgnoreCase(sale.getString("eftposBankTerminalId"))
                        && !date.before(sale.getDate("eftposReceiptDate"));
                if ("MATCHED".equals(decision) && !evidenceMatches) return denied();
                if ("DISCREPANCY".equals(decision) && evidenceMatches) return denied();
                GenericValue entry = d.makeValue("WanPosEftposReconciliation");
                entry.set("reconciliationKey", reviewKey);
                entry.set("idempotencyKey", saleKey);
                entry.set("requestFingerprint", fingerprint);
                entry.set("productStoreId", sale.getString("productStoreId"));
                entry.set("facilityId", sale.getString("facilityId"));
                entry.set("decision", decision);
                entry.set("evidenceSource", source);
                entry.set("bankTerminalId", bankTerminal);
                entry.set("rrn", rrn);
                entry.set("approvalCode", code);
                entry.set("settlementReference", batch);
                entry.set("settlementDate", date);
                entry.set("expectedAmount", expected);
                entry.set("settledAmount", observed);
                entry.set("actorUserLoginId", accountant.getString("userLoginId"));
                entry.set("actorPartyId", accountant.getString("partyId"));
                entry.set("reason", reason.trim());
                entry.set("recordedAt", new Timestamp(System.currentTimeMillis()));
                d.create(entry);
                sale.set("eftposReconciliationStatus", "MATCHED".equals(decision) ? "RECONCILED" : "DISCREPANCY");
                sale.store();
                audit(dctx, accountant, "EFTPOS_RECONCILE", sale.getString("productStoreId"),
                        sale.getString("facilityId"), sale.getString("terminalId"), sale.getString("shiftId"),
                        sale.getString("orderId"), string(ctx, "requestId"), decision);
                Map<String, Object> result = ok("reconciliation", data(entry, "reconciliationKey",
                        "idempotencyKey", "decision", "settledAmount", "settlementReference",
                        "actorUserLoginId", "recordedAt"));
                result.put("eftposReconciliationStatus", sale.getString("eftposReconciliationStatus"));
                return result;
            }
        } catch (Exception e) {
            return error(e);
        }
    }

