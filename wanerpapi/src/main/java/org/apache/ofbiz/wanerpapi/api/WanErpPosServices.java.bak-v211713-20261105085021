    public static Map<String, Object> lookupProduct(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "lookupProduct");
            GenericValue t = accessibleTerminal(dctx, who, required(ctx, "terminalId"), "SALE");
            String raw = string(ctx, "barcode");
            if (raw == null || !BARCODE.matcher(raw).matches()) {
                return denied();
            }
            if (!raw.matches("[0-9]{8}|[0-9]{12,14}")) {
                return ServiceUtil.returnError("Unsupported barcode symbology/profile");
            }
            // Variable-weight labels must never fall through to fixed GoodIdentification lookup.
            // Decode genuine captured labels into real values, even before profile approval.
            // Unapproved profiles remain checkout-ineligible until a physical evidence check.
            if (raw.length() == 13 && raw.substring(0, 2).matches("2[0-9]")) {
                return lookupScaleBarcode(dctx, who, t, raw);
            }
            if (!gtinValid(raw)) {
                return ServiceUtil.returnError("Invalid GTIN check digit");
            }
            GenericValue found = null;
            for (GenericValue id : EntityQuery.use(dctx.getDelegator()).from("GoodIdentification").where("idValue", raw).queryList()) {
                if (!Set.of("EAN", "EAN13", "EAN8", "UPC", "GTIN").contains(id.getString("goodIdentificationTypeId"))) {
                    continue;
                }
                GenericValue product = EntityQuery.use(dctx.getDelegator()).from("Product").where("productId", id.getString("productId")).queryOne();
                if (product == null) {
                    continue;
                }
                if (found != null && !found.getString("productId").equals(product.getString("productId"))) {
                    return ServiceUtil.returnError("Ambiguous barcode; supervisor required");
                }
                found = product;
            }
            if (found == null) {
                return ServiceUtil.returnError("Unrecognized barcode");
            }
            BigDecimal price = price(dctx, found.getString("productId"), t.getString("productStoreId"), BigDecimal.ONE);
            if (price == null || price.signum() < 0) {
                return ServiceUtil.returnError("Product price unavailable");
            }
            Map<String, Object> product = data(found, "productId", "productName", "internalName", "quantityUomId", "orderDecimalQuantity",
                    "smallImageUrl");
            product.put("barcode", raw);
            product.put("barcodeType", "FIXED_GTIN");
            product.put("quantity", BigDecimal.ONE);
            product.put("unitPrice", price);
            product.put("currencyUomId", "PGK");
            product.put("subtotal", price);
            product.put("productStoreId", t.getString("productStoreId"));
            product.put("facilityId", t.getString("facilityId"));
            return ok("product", product);
        } catch (Exception e) {
            return error(e);
        }
    }
    /**
     * Decode a weight-encoded EAN-13 label. Does not mutate stock, orders, or profile validation.
     * A scanned label is decoded mathematically, not simulated. Before physical
     * approval it is a read-only calculated result and cannot enter checkout.
     */
    private static Map<String, Object> lookupScaleBarcode(DispatchContext dctx, GenericValue who,
            GenericValue terminal, String raw) throws Exception {
        if (!gtinValid(raw)) {
            return ServiceUtil.returnError("Invalid variable-weight EAN-13 check digit");
        }
        Delegator d = dctx.getDelegator();
        String storeId = terminal.getString("productStoreId");
        GenericValue matched = null;
        for (GenericValue candidate : EntityQuery.use(d).from("WanPosScaleProfile")
                .where("productStoreId", storeId).queryList()) {
            String prefix = candidate.getString("prefix");
            if (prefix == null || !raw.startsWith(prefix)) {
                continue;
            }
            if (matched != null) {
                return ServiceUtil.returnError("Ambiguous scale profile for barcode prefix");
            }
            matched = candidate;
        }
        if (matched == null) {
            return ServiceUtil.returnError("No matching scale profile for barcode prefix");
        }
        Number pluField = (Number) matched.get("pluDigits");
        Number weightField = (Number) matched.get("weightDigits");
        Number decimalsField = (Number) matched.get("weightDecimals");
        if (pluField == null || weightField == null || decimalsField == null) {
            return ServiceUtil.returnError("Scale label profile incomplete");
        }
        int pluDigits = pluField.intValue();
        int weightDigits = weightField.intValue();
        int weightDecimals = decimalsField.intValue();
        String prefix = matched.getString("prefix");
        if (!prefix.matches("2[0-9]") || pluDigits < 1 || pluDigits > 8
                || weightDigits < 1 || weightDigits > 8
                || weightDecimals < 0 || weightDecimals > weightDigits
                || 2 + pluDigits + weightDigits != 12) {
            return ServiceUtil.returnError("Unsupported variable-weight label layout");
        }
        String pluCode = raw.substring(2, 2 + pluDigits);
        String weightCode = raw.substring(2 + pluDigits, 12);
        BigDecimal quantity = new BigDecimal(weightCode).movePointLeft(weightDecimals);
        // SHONG TM-30Ab nominal range: 0.200–30.000 kg; measure physical settings separately.
        if (quantity.compareTo(new BigDecimal("0.200")) < 0
                || quantity.compareTo(new BigDecimal("30.000")) > 0) {
            return ServiceUtil.returnError("Scale weight outside configured UAT range");
        }
        GenericValue plu = EntityQuery.use(d).from("WanPosScalePluMap")
                .where("scaleId", matched.getString("scaleId"), "pluCode", pluCode).queryOne();
        if (plu == null || !"Y".equals(plu.getString("enabled"))) {
            return ServiceUtil.returnError("Unrecognized or disabled scale PLU");
        }
        String productId = plu.getString("productId");
        GenericValue found = EntityQuery.use(d).from("Product").where("productId", productId).queryOne();
        if (found == null || !"WT_kg".equals(found.getString("quantityUomId"))) {
            return ServiceUtil.returnError("PLU product is not an active kilogram product");
        }
        Map<String, Object> invParams = new HashMap<>();
        invParams.put("productId", productId);
        invParams.put("facilityId", terminal.getString("facilityId"));
        invParams.put("userLogin", who);
        Map<String, Object> inv = dctx.getDispatcher().runSync("getInventoryAvailableByFacility", invParams);
        Object atp = inv.get("availableToPromiseTotal");
        if (!ServiceUtil.isSuccess(inv) || !(atp instanceof BigDecimal)
                || ((BigDecimal) atp).compareTo(quantity) < 0) {
            return ServiceUtil.returnError("Insufficient weighed-product inventory");
        }
        BigDecimal unit = price(dctx, productId, storeId, quantity);
        if (unit == null || unit.signum() <= 0) {
            return ServiceUtil.returnError("Scale PLU product price unavailable");
        }
        Map<String, Object> product = data(found, "productId", "productName", "internalName",
                "quantityUomId", "orderDecimalQuantity", "smallImageUrl");
        product.put("barcode", raw);
        product.put("barcodeType", "VARIABLE_WEIGHT_EAN13");
        product.put("scaleId", matched.getString("scaleId"));
        product.put("pluCode", pluCode);
        product.put("quantity", quantity);
        product.put("unitPrice", unit);
        product.put("subtotal", unit.multiply(quantity).setScale(2, java.math.RoundingMode.HALF_UP));
        product.put("currencyUomId", "PGK");
        product.put("productStoreId", storeId);
        product.put("facilityId", terminal.getString("facilityId"));
        boolean approved = "Y".equals(matched.getString("validated"));
        product.put("calculationSource", "EAN13_BARCODE_PAYLOAD");
        product.put("scaleProfileValidated", approved);
        product.put("checkoutEligible", approved);
        product.put("validationStatus", approved ? "APPROVED" : "AWAITING_PHYSICAL_APPROVAL");
        return ok("product", product);
    }

    private static boolean gtinValid(String digits) {
        if (!digits.matches("[0-9]{8}|[0-9]{12,14}")) {
            return false;
        }
        int sum = 0;
        int weight = 3;
        for (int i = digits.length() - 2; i >= 0; i--) {
            sum += (digits.charAt(i) - '0') * weight;
            weight = weight == 3 ? 1 : 3;
        }
        return ((10 - (sum % 10)) % 10) == digits.charAt(digits.length() - 1) - '0';
    }
    private static BigDecimal price(DispatchContext dctx, String productId, String store, BigDecimal qty) throws Exception {
        GenericValue product = EntityQuery.use(dctx.getDelegator()).from("Product").where("productId", productId).queryOne();
        if (product == null) {
            return null;
        }
        Map<String, Object> input = new HashMap<>();
        input.put("product", product);
        input.put("productStoreId", store);
        input.put("quantity", qty);
        input.put("currencyUomId", "PGK");
        Map<String, Object> result = dctx.getDispatcher().runSync("calculateProductPrice", input);
        if (!ServiceUtil.isSuccess(result) || !(result.get("price") instanceof BigDecimal)) {
            return null;
        }
        return (BigDecimal) result.get("price");
    }
