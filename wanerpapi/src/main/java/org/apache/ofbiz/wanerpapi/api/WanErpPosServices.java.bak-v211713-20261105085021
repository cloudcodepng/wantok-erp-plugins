    /** Administrator enrolls a badge to ONE manager at ONE authorized location. */
    /** Badge eligibility: explicitly assigned tenant MANAGER role, not elevated permissions alone. */
    private static boolean badgeManagerRole(DispatchContext dctx, GenericValue user) throws Exception {
        if (user == null || "N".equalsIgnoreCase(user.getString("enabled"))) {
            return false;
        }
        Delegator delegator = dctx.getDelegator();
        String group = tenant(delegator).toUpperCase(Locale.ROOT) + "_MANAGER";
        java.sql.Timestamp now = new java.sql.Timestamp(System.currentTimeMillis());
        for (GenericValue membership : EntityQuery.use(delegator).from("UserLoginSecurityGroup")
                .where("userLoginId", user.getString("userLoginId"), "groupId", group)
                .queryList()) {
            java.sql.Timestamp start = membership.getTimestamp("fromDate");
            java.sql.Timestamp end = membership.getTimestamp("thruDate");
            if ((start == null || !start.after(now)) && (end == null || end.after(now))) {
                return true;
            }
        }
        return false;
    }

