    public static Map<String, Object> getSale(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "getSale");
            GenericValue sale = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                    .where("idempotencyKey", required(ctx, "idempotencyKey")).queryOne();
            if (sale == null) {
                return denied();
            }
            scope(dctx, who, sale.getString("productStoreId"), sale.getString("facilityId"), "VIEW");
            if (!who.getString("userLoginId").equals(sale.getString("actorUserLoginId")) && !allowed(dctx, who, "REPORT")) {
                return denied();
            }
            Map<String, Object> result = data(sale, "idempotencyKey", "productStoreId", "terminalId", "shiftId", "orderId",
                    "paymentId", "receiptNumber", "actorUserLoginId", "statusId", "totalAmount",
                    "invoiceId", "tenderType",
                    "eftposBankTerminalId", "eftposReference", "eftposApprovalCode", "eftposReceiptDate",
                    "eftposReceiptAmount", "eftposEvidenceStatus", "eftposReconciliationStatus");
            List<Map<String, Object>> lines = new ArrayList<>();
            // Authoritative native OFBiz returns, not POS UI/browser history.
            // Unknown/missing return-header state is conservatively counted.
            Map<String, BigDecimal> returnedBySeq = new HashMap<>();
            boolean hasPriorReturns = false;
            if (sale.getString("orderId") != null) {
                for (GenericValue prior : EntityQuery.use(dctx.getDelegator()).from("ReturnItem")
                        .where("orderId", sale.getString("orderId")).queryList()) {
                    GenericValue header = EntityQuery.use(dctx.getDelegator()).from("ReturnHeader")
                            .where("returnId", prior.getString("returnId")).queryOne();
                    String status = header == null ? null : header.getString("statusId");
                    // Exclude known cancelled/rejected returns only. In-flight returns reserve quantity.
                    if ("RETURN_CANCELLED".equals(status) || "RETURN_REJECTED".equals(status)) {
                        continue;
                    }
                    String seq = prior.getString("orderItemSeqId");
                    BigDecimal priorQty = prior.getBigDecimal("returnQuantity");
                    if (seq != null && priorQty != null && priorQty.signum() > 0) {
                        returnedBySeq.merge(seq, priorQty, BigDecimal::add);
                        hasPriorReturns = true;
                    }
                }
            }
            if (sale.getString("orderId") != null) {
                for (GenericValue item : EntityQuery.use(dctx.getDelegator()).from("OrderItem")
                        .where("orderId", sale.getString("orderId")).queryList()) {
                    if (item.getString("productId") != null) {
                        Map<String, Object> line = data(item, "orderItemSeqId", "productId", "quantity", "unitPrice", "statusId");
                        BigDecimal sold = item.getBigDecimal("quantity");
                        BigDecimal previouslyReturned = returnedBySeq.getOrDefault(item.getString("orderItemSeqId"), BigDecimal.ZERO);
                        BigDecimal remaining = (sold == null ? BigDecimal.ZERO : sold.subtract(previouslyReturned))
                                .max(BigDecimal.ZERO);
                        line.put("previouslyReturnedQuantity", previouslyReturned);
                        line.put("returnableQuantity", remaining);
                        GenericValue product = EntityQuery.use(dctx.getDelegator()).from("Product")
                                .where("productId", item.getString("productId")).queryOne();
                        line.put("productName", product == null ? item.getString("productId")
                                : product.getString("internalName"));
                        lines.add(line);
                    }
                }
            }
            result.put("items", lines);
            result.put("hasPriorReturns", hasPriorReturns);
            result.put("returnEligibilityVerified", true);
            // Original tender and cashback are read-only evidence for the cashier's C09 screen.
            // Cashback is NOT a merchandise refund and must never be added to return amount.
            List<GenericValue> tenderRecords = EntityQuery.use(dctx.getDelegator())
                    .from("WanPosV396SaleTender")
                    .where("idempotencyKey", sale.getString("idempotencyKey")).queryList();
            List<Map<String, Object>> tenderDetails = new ArrayList<>();
            for (GenericValue portion : tenderRecords) {
                tenderDetails.add(data(portion, "tenderType", "amount"));
            }
            result.put("v396Sale", !tenderRecords.isEmpty());
            result.put("tenders", tenderDetails);
            GenericValue originalCashout = EntityQuery.use(dctx.getDelegator())
                    .from("WanPosV396Cashout")
                    .where("idempotencyKey", sale.getString("idempotencyKey")).queryOne();
            result.put("cashOutAmount", originalCashout == null ? BigDecimal.ZERO
                    : originalCashout.getBigDecimal("cashOutAmount"));
            result.put("bankChargeAmount", originalCashout == null ? null
                    : originalCashout.getBigDecimal("bankAmount"));
            return ok("sale", result);
        } catch (Exception e) {
            return error(e);
        }
    }
