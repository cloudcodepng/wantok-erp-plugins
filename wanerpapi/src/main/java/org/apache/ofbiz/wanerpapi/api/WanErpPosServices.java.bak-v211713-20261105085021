    /** Bounded completed-sale discovery for cashier receipts and manager-approved returns.
     * Cashiers see only their own sale records; manager visibility requires RETURN and REFUND
     * rights (or an explicit REPORT permission). Never returns card evidence or payment secrets.
     */
    public static Map<String, Object> listRecentSales(DispatchContext dctx, Map<String, Object> ctx) {
        try {
            GenericValue who = actor(dctx, ctx, "listRecentSales");
            String store = required(ctx, "productStoreId");
            String fac = required(ctx, "facilityId");
            scope(dctx, who, store, fac, "VIEW");
            // Store administrators can review completed sales for authorized return operations;
            // cashiers remain restricted to their own sales, including across browser sessions.
            boolean privileged = allowed(dctx, who, "REPORT")
                    || (allowed(dctx, who, "RETURN") && allowed(dctx, who, "REFUND"))
                    || (allowed(dctx, who, "TERMINAL_ADMIN")
                        && grant(dctx.getDelegator(), who.getString("userLoginId"), store, fac, "MANAGE"));
            int limit = 50;
            Object raw = ctx.get("maxRows");
            if (raw instanceof Number) {
                limit = Math.max(1, Math.min(50, ((Number) raw).intValue()));
            }
            List<GenericValue> records;
            if (privileged) {
                records = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                        .where("productStoreId", store, "facilityId", fac, "statusId", "COMPLETED")
                        .orderBy("-createdAt").maxRows(limit).queryList();
            } else {
                records = EntityQuery.use(dctx.getDelegator()).from("WanPosSaleRequest")
                        .where("productStoreId", store, "facilityId", fac, "statusId", "COMPLETED",
                                "actorUserLoginId", who.getString("userLoginId"))
                        .orderBy("-createdAt").maxRows(limit).queryList();
            }
            List<Map<String, Object>> sales = new ArrayList<>();
            for (GenericValue sale : records) {
                Map<String, Object> row = data(sale, "idempotencyKey", "orderId", "receiptNumber",
                        "totalAmount", "createdAt", "actorUserLoginId", "terminalId", "tenderType", "statusId");
                List<Map<String, Object>> items = new ArrayList<>();
                if (sale.getString("orderId") != null) {
                    for (GenericValue item : EntityQuery.use(dctx.getDelegator()).from("OrderItem")
                            .where("orderId", sale.getString("orderId")).maxRows(50).queryList()) {
                        if (item.getString("productId") == null) {
                            continue;
                        }
                        Map<String, Object> line = data(item, "orderItemSeqId", "productId", "quantity");
                        GenericValue product = EntityQuery.use(dctx.getDelegator()).from("Product")
                                .where("productId", item.getString("productId")).queryOne();
                        line.put("productName", product == null ? item.getString("productId")
                                : product.getString("internalName"));
                        items.add(line);
                    }
                }
                row.put("items", items);
                sales.add(row);
            }
            Map<String, Object> response = ok("sales", sales);
            response.put("productStoreId", store);
            response.put("facilityId", fac);
            return response;
        } catch (Exception e) {
            return error(e);
        }
    }

