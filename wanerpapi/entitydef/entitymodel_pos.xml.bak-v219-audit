<?xml version="1.0" encoding="UTF-8"?>
<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
  <title>Wantok POS supplementary entities — native OFBiz remains financial source of truth</title>
  <description>Generic multitenant POS scope, terminal, shift and audit records. No Product, Order, Payment or Inventory duplication.</description>
  <version>1.0.0</version>
  <entity entity-name="WanPosUserStoreGrant" package-name="org.apache.ofbiz.wanerpapi.pos" title="Effective per-user store and optional facility authorization">
    <field name="grantId" type="id"/><field name="userLoginId" type="id-vlong"/>
    <field name="productStoreId" type="id"/><field name="facilityId" type="id"/>
    <field name="accessCode" type="id"/><field name="fromDate" type="date-time"/>
    <field name="thruDate" type="date-time"/><field name="grantedByUserLoginId" type="id-vlong"/>
    <field name="reason" type="description"/>
    <prim-key field="grantId"/>
    <relation type="one" fk-name="WANPOS_GRNT_UL" rel-entity-name="UserLogin"><key-map field-name="userLoginId"/></relation>
    <relation type="one" fk-name="WANPOS_GRNT_ST" rel-entity-name="ProductStore"><key-map field-name="productStoreId"/></relation>
  </entity>
  <entity entity-name="WanPosManagerBadge" package-name="org.apache.ofbiz.wanerpapi.pos" title="Individually issued manager Code 128 badge; no plaintext credential at rest">
    <field name="badgeId" type="id-long"/><field name="badgeHash" type="id-vlong"/>
    <field name="managerUserLoginId" type="id-vlong"/><field name="productStoreId" type="id"/>
    <field name="facilityId" type="id"/><field name="statusId" type="id"/>
    <field name="issuedByUserLoginId" type="id-vlong"/><field name="issuedAt" type="date-time"/>
    <field name="revokedAt" type="date-time"/><field name="revokedByUserLoginId" type="id-vlong"/>
    <prim-key field="badgeId"/>
    <relation type="one" fk-name="WANPOS_MB_UL" rel-entity-name="UserLogin"><key-map field-name="managerUserLoginId"/></relation>
  </entity>
  <entity entity-name="WanPosTerminal" package-name="org.apache.ofbiz.wanerpapi.pos" title="POS registered lane">
    <field name="terminalId" type="id"/><field name="productStoreId" type="id"/>
    <field name="facilityId" type="id"/><field name="description" type="description"/>
    <field name="enabled" type="indicator"/><field name="drawerMode" type="id"/>
    <field name="updatedByUserLoginId" type="id-vlong"/><field name="updatedAt" type="date-time"/>
    <prim-key field="terminalId"/>
    <relation type="one" fk-name="WANPOS_TERM_ST" rel-entity-name="ProductStore"><key-map field-name="productStoreId"/></relation>
    <relation type="one" fk-name="WANPOS_TERM_FAC" rel-entity-name="Facility"><key-map field-name="facilityId"/></relation>
  </entity>
  <entity entity-name="WanPosTerminalDevice" package-name="org.apache.ofbiz.wanerpapi.pos" title="One device configuration per terminal and type">
    <field name="terminalId" type="id"/><field name="deviceType" type="id"/>
    <field name="connectionType" type="id"/><field name="deviceName" type="description"/>
    <field name="portName" type="id-long"/><field name="settingsJson" type="very-long"/>
    <field name="updatedAt" type="date-time"/>
    <prim-key field="terminalId"/><prim-key field="deviceType"/>
    <relation type="one" fk-name="WANPOS_DEVICE_TERM" rel-entity-name="WanPosTerminal"><key-map field-name="terminalId"/></relation>
  </entity>
  <entity entity-name="WanPosShift" package-name="org.apache.ofbiz.wanerpapi.pos" title="Immutable lane/store/cashier shift identity">
    <field name="shiftId" type="id"/><field name="terminalId" type="id"/>
    <field name="productStoreId" type="id"/><field name="facilityId" type="id"/>
    <field name="cashierUserLoginId" type="id-vlong"/><field name="openedAt" type="date-time"/>
    <field name="closedAt" type="date-time"/><field name="closedByUserLoginId" type="id-vlong"/>
    <field name="statusId" type="id"/><field name="openingFloat" type="currency-amount"/>
    <field name="closingCashCount" type="currency-amount"/>
    <field name="expectedCash" type="currency-amount"/>
    <field name="cashVariance" type="currency-amount"/>
    <prim-key field="shiftId"/>
    <relation type="one" fk-name="WANPOS_SHIFT_TERM" rel-entity-name="WanPosTerminal"><key-map field-name="terminalId"/></relation>
  </entity>
  <entity entity-name="WanPosSaleRequest" package-name="org.apache.ofbiz.wanerpapi.pos" title="POS sale idempotency and immutable result pointers">
    <field name="idempotencyKey" type="id-long"/><field name="requestFingerprint" type="id-long"/>
    <field name="terminalId" type="id"/><field name="shiftId" type="id"/>
    <field name="productStoreId" type="id"/><field name="facilityId" type="id"/>
    <field name="actorUserLoginId" type="id-vlong"/><field name="orderId" type="id"/>
    <field name="paymentId" type="id"/><field name="invoiceId" type="id"/>
    <field name="tenderType" type="id"/><field name="cashReceived" type="currency-amount"/>
    <field name="cashChange" type="currency-amount"/><field name="receiptNumber" type="id-long"/>
    <field name="statusId" type="id"/><field name="totalAmount" type="currency-amount"/>
    <field name="eftposBankTerminalId" type="id-long"/><field name="eftposReference" type="id-long"/>
    <field name="eftposApprovalCode" type="id"/><field name="eftposReceiptDate" type="date"/>
    <field name="eftposReceiptAmount" type="currency-amount"/>
    <field name="eftposEvidenceStatus" type="id"/><field name="eftposReconciliationStatus" type="id"/>
    <field name="createdAt" type="date-time"/><field name="updatedAt" type="date-time"/>
    <prim-key field="idempotencyKey"/>
  </entity>
  <entity entity-name="WanPosEftposReconciliation" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Immutable independent bank settlement review for a native POS sale">
    <field name="reconciliationKey" type="id-long"/>
    <field name="idempotencyKey" type="id-long"/>
    <field name="requestFingerprint" type="id-vlong"/>
    <field name="productStoreId" type="id"/><field name="facilityId" type="id"/>
    <field name="decision" type="id"/><field name="evidenceSource" type="id"/>
    <field name="bankTerminalId" type="id-long"/><field name="rrn" type="id-long"/>
    <field name="approvalCode" type="id"/>
    <field name="settlementReference" type="id-vlong"/>
    <field name="settlementDate" type="date"/>
    <field name="expectedAmount" type="currency-amount"/>
    <field name="settledAmount" type="currency-amount"/>
    <field name="actorUserLoginId" type="id-vlong"/>
    <field name="actorPartyId" type="id"/>
    <field name="reason" type="description"/>
    <field name="recordedAt" type="date-time"/>
    <prim-key field="reconciliationKey"/>
    <relation type="one" fk-name="WANPOS_RECON_SALE" rel-entity-name="WanPosSaleRequest">
      <key-map field-name="idempotencyKey"/>
    </relation>
  </entity>
  <entity entity-name="WanPosAudit" package-name="org.apache.ofbiz.wanerpapi.pos" title="Append-only POS access and activity events">
    <field name="auditId" type="id"/><field name="eventAt" type="date-time"/>
    <field name="actorUserLoginId" type="id-vlong"/><field name="actorPartyId" type="id"/>
    <field name="productStoreId" type="id"/><field name="facilityId" type="id"/>
    <field name="terminalId" type="id"/><field name="shiftId" type="id"/>
    <field name="action" type="id" col-name="POS_ACTION"/><field name="entityId" type="id"/>
    <field name="requestId" type="id-long"/><field name="outcome" type="id"/>
    <field name="reason" type="description"/>
    <prim-key field="auditId"/>
  </entity>
  <entity entity-name="WanPosScaleProfile" package-name="org.apache.ofbiz.wanerpapi.pos" title="Scale barcode parser profile; unverified profile cannot sell">
    <field name="scaleId" type="id"/><field name="productStoreId" type="id"/>
    <field name="prefix" type="id" col-name="SCALE_PREFIX"/><field name="pluDigits" type="numeric"/>
    <field name="weightDigits" type="numeric"/><field name="weightDecimals" type="numeric"/>
    <field name="validated" type="indicator"/><field name="updatedAt" type="date-time"/>
    <prim-key field="scaleId"/>
  </entity>
  <entity entity-name="WanPosScalePluMap" package-name="org.apache.ofbiz.wanerpapi.pos" title="Store-specific scale PLU mapping; price remains ProductPrice">
    <field name="scaleId" type="id"/><field name="pluCode" type="id"/>
    <field name="productId" type="id"/><field name="enabled" type="indicator"/>
    <field name="updatedAt" type="date-time"/>
    <prim-key field="scaleId"/><prim-key field="pluCode"/>
    <relation type="one" fk-name="WANPOS_PLU_SCALE" rel-entity-name="WanPosScaleProfile"><key-map field-name="scaleId"/></relation>
    <relation type="one" fk-name="WANPOS_PLU_PROD" rel-entity-name="Product"><key-map field-name="productId"/></relation>
  </entity>
  <entity entity-name="WanPosReturnRequest" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Idempotent POS customer return and refund ledger">
    <field name="returnRequestKey" type="id-long"/>
    <field name="originalSaleKey" type="id-long"/><field name="shiftId" type="id"/>
    <field name="productStoreId" type="id"/><field name="refundTenderType" type="id"/>
    <field name="eftposBankTerminalId" type="id-long"/><field name="eftposReference" type="id-long"/>
    <field name="eftposApprovalCode" type="id"/><field name="eftposReceiptDate" type="date"/>
    <field name="eftposReceiptAmount" type="currency-amount"/>
    <field name="eftposEvidenceStatus" type="id"/><field name="eftposReconciliationStatus" type="id"/>
    <field name="requestFingerprint" type="id-long"/>
    <field name="returnId" type="id"/>
    <field name="creditInvoiceId" type="id"/>
    <field name="refundPaymentId" type="id"/>
    <field name="actorUserLoginId" type="id-vlong"/>
    <field name="approvedByUserLoginId" type="id-vlong"/>
    <field name="totalRefund" type="currency-amount"/>
    <field name="statusId" type="id"/>
    <field name="createdAt" type="date-time"/>
    <prim-key field="returnRequestKey"/>
  </entity>

  <entity entity-name="WanPosRefundApproval" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Single-use manager authorization for one POS refund and one payout shift">
    <field name="approvalId" type="id-long"/>
    <field name="originalSaleKey" type="id-long"/>
    <field name="operationCode" type="id"/>
    <field name="requestFingerprint" type="id-long"/>
    <field name="productStoreId" type="id"/>
    <field name="facilityId" type="id"/>
    <field name="terminalId" type="id"/>
    <field name="shiftId" type="id"/>
    <field name="cashierUserLoginId" type="id-vlong"/>
    <field name="approvedByUserLoginId" type="id-vlong"/>
    <field name="approvedAmount" type="currency-amount"/>
    <field name="statusId" type="id"/>
    <field name="createdAt" type="date-time"/>
    <field name="expiresAt" type="date-time"/>
    <field name="consumedAt" type="date-time"/>
    <field name="returnRequestKey" type="id-long"/>
    <prim-key field="approvalId"/>
  </entity>
  <entity entity-name="WanPosCashMovement" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Immutable cash event, transactionally linked to a sale, refund or transfer">
    <field name="movementId" type="id-long"/>
    <field name="eventAt" type="date-time"/>
    <field name="shiftId" type="id"/>
    <field name="terminalId" type="id"/>
    <field name="productStoreId" type="id"/>
    <field name="movementType" type="id"/>
    <field name="sourceReference" type="id-long"/>
    <field name="amount" type="currency-amount"/>
    <field name="actorUserLoginId" type="id-vlong"/>
    <field name="approvedByUserLoginId" type="id-vlong"/>
    <field name="reason" type="description"/>
    <prim-key field="movementId"/>
  </entity>

  <!-- v3.9.6: primary-source allocation records; never reinterpret the existing sale/payment columns. -->
  <entity entity-name="WanPosV396SaleTender" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Native v396 sale tender allocation, one per method per sale">
    <field name="idempotencyKey" type="id-long"/>
    <field name="tenderType" type="id"/>
    <field name="amount" type="currency-amount"/>
    <field name="paymentId" type="id"/>
    <field name="paymentPreferenceId" type="id"/>
    <prim-key field="idempotencyKey"/><prim-key field="tenderType"/>
  </entity>
  <entity entity-name="WanPosV396Cashout" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Linked customer EFTPOS cash-out, separate from merchandise and GST">
    <field name="idempotencyKey" type="id-long"/>
    <field name="cashOutAmount" type="currency-amount"/>
    <field name="bankAmount" type="currency-amount"/>
    <field name="cardFundingPaymentId" type="id"/>
    <field name="cashPayoutPaymentId" type="id"/>
    <field name="statusId" type="id"/>
    <prim-key field="idempotencyKey"/>
  </entity>
  <entity entity-name="WanPosV396ReturnTender" package-name="org.apache.ofbiz.wanerpapi.pos"
      title="Native return tender allocations and payment identifiers">
    <field name="returnRequestKey" type="id-long"/>
    <field name="tenderType" type="id"/>
    <field name="amount" type="currency-amount"/>
    <field name="refundPaymentId" type="id"/>
    <prim-key field="returnRequestKey"/><prim-key field="tenderType"/>
  </entity>
</entitymodel>
